        TheKing.StopAll()
        meleeEnabled = false
        skillAuraOn = false
        Cbt.syncBossParry()
        Cbt.syncAoeDodge()
        chestEspOn = false
        warnOn = false
        fakeNameOn = false
        Cbt._dodgeOn = false

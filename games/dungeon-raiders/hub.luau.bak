local CLASS_PROFILES = {}
local CLASS_BY_FOLDER = {}
local ClassKit = {}

local function buildClassNameIndex()
    local idx = {}
    local function add(key, folder)
        if type(key) == "string" and key ~= "" and type(folder) == "string" then
            idx[string.lower(key)] = folder
        end
    end
    local classes = ReplicatedStorage:FindFirstChild("Classes")
    if not classes then
        return idx
    end
    local classData = nil
    local cdMod = classes:FindFirstChild("Class_Data")
    if cdMod then
        local ok, data = pcall(require, cdMod)
        if ok and type(data) == "table" then
            classData = data
        end
    end
    if type(classData) == "table" then
        for k, v in pairs(classData) do
            if type(k) == "string" and type(v) == "table" then
                add(k, k)
                add(v.Name, k)
            end
        end
    end
    add("被诅咒的孩子", "Cursed Child")
    add("锻造霸主", "Forge Archon")
    add("忍者", "Shinobi")
    add("shinobi", "Shinobi")
    add("ninja", "Shinobi")
    add("阿蒂米斯", "Artemis")
    add("火焰据点", "Flame Bastion")
    add("火据点", "Flame Bastion")
    add("卡奇", "Kage")
    add("kage", "Kage")
    add("真空", "Vacio")
    add("vacio", "Vacio")
    add("蔚蓝恶魔", "Azure Devil")
    add("azure devil", "Azure Devil")
    add("蔚蓝", "Azure Devil")
    add("审批之刃", "Awakened Devil EX")
    add("awakened devil ex", "Awakened Devil EX")
    add("觉醒恶魔", "Awakened Devil EX")
    add("拳击手", "Boxer")
    add("boxer", "Boxer")
    add("无限核心", "Honored One")
    add("honored one", "Honored One")
    add("五条悟", "Honored One")
    add("倒置长矛", "Unrestricted")
    add("unrestricted", "Unrestricted")
    add("倒置的长矛", "Unrestricted")
    add("反转天枪", "Unrestricted")
    for _, f in ipairs(classes:GetChildren()) do
        if f:IsA("Folder") or f:IsA("ModuleScript") then
            local name = f.Name
            if name ~= "Class_Data" and name ~= "PackageLink" then
                add(name, name)
                if not (classData and type(classData[name]) == "table") then
                    local defMod = f:FindFirstChild("Definition")
                    if defMod then
                        local ok, def = pcall(require, defMod)
                        if ok and type(def) == "table" then
                            add(def.Name, name)
                        end
                    end
                end
            end
        end
    end
    return idx
end

local function resolveClassFolder(hint, idx)
    if type(hint) ~= "string" or hint == "" then
        return nil
    end
    local key = string.lower(hint)
    if idx[key] then
        return idx[key]
    end
    local en = hint:match("^([^（(]+)")
    if en then
        en = (en:gsub("%s+$", ""))
        local k2 = string.lower(en)
        if idx[k2] then
            return idx[k2]
        end
    end
    local zh = hint:match("（([^）]+)）") or hint:match("%(([^%)]+)%)")
    if zh then
        local k3 = string.lower(zh)
        if idx[k3] then
            return idx[k3]
        end
        hint = zh
        key = k3
    end
    local best, bestLen = nil, 0
    for k, folder in pairs(idx) do
        if #k >= 2 and (string.find(key, k, 1, true) or string.find(k, key, 1, true)) then
            if #k > bestLen then
                best, bestLen = folder, #k
            end
        end
    end
    return best
end

local function normSkill(slot, s)
    if type(s) ~= "table" then
        return nil
    end
    -- 双形态子表 (倒置长矛 { Sword={Range,Cd}, Spear={Range,Cd} }): 原样透传, 视图层按形态取
    -- (顶层无 Range/Cd, 走通用提取会全 nil 被过滤 → 1/2/3 消失)
    if s.Sword or s.Spear then
        return {
            Dual = true,
            Sword = s.Sword,
            Spear = s.Spear,
        }
    end
    local range = tonumber(s.Range or s.HitboxRange or s.TickHitboxRange)
    return {
        AnimationName = s.AnimationName or ("Ability_" .. tostring(slot)),
        Cooldown = tonumber(s.Cd or s.Cooldown),
        MaxCharges = tonumber(s.Charges or s.MaxCharges),
        HitboxRange = range,
        TickHitboxRange = tonumber(s.TickHitboxRange),
        MaxDuration = tonumber(s.Duration or s.MaxDuration),
        DashSpeed = tonumber(s.Dash or s.DashSpeed),
        Hits = tonumber(s.Hits or s.HitCount or s.FinalHit),
        Steer = s.Steer == true,
        HitboxSize = s.HitboxSize,
        TickHitboxSize = s.TickHitboxSize,
    }
end

local function normalizeEntry(raw, idx)
    if type(raw) ~= "table" then
        return nil
    end
    local hint = raw.Name or raw.Class or raw.Label or raw.Folder
    local folder = resolveClassFolder(hint, idx)
    if not folder then
        warn("[RCWTK] 职业档案无法识别: " .. tostring(hint) .. " (对照游戏 Current_Class 改 Name)")
        return nil
    end
    local skills = nil
    local src = raw.Skills
    if type(src) == "table" then
        skills = {}
        local n = 0
        for i = 1, 4 do
            local one = normSkill(i, src[i])
            if one and (one.Dual or one.HitboxRange or one.MaxCharges or one.Cooldown) then
                skills[i] = one
                n = n + 1
            end
        end
        if n == 0 then
            skills = nil
        end
    end
    local display = raw.Name or raw.Label or folder
    return {
        Folder = folder,
        Name = display,
        Label = display,
        MeleeRange = tonumber(raw.Range or raw.MeleeRange),
        BowRange = tonumber(raw.Bow or raw.BowRange),
        SpecialRangeBonus = tonumber(raw.SpecialRangeBonus),
        AtkSpd = tonumber(raw.AtkSpd) or 1,
        SkipRequire = raw.SkipRequire == true or skills ~= nil,
        Ranged = raw.Ranged == true,
        DualForm = raw.DualForm == true,
        Skills = skills,
    }
end

local function normalizeArchive(data, idx)
    if type(data) ~= "table" then
        return {}
    end
    local rows = data
    if data[1] == nil then
        rows = {}
        local bag = data.Classes or data.classes
        if type(bag) == "table" then
            for k, v in pairs(bag) do
                if type(v) == "table" then
                    v.Name = v.Name or k
                    rows[#rows + 1] = v
                end
            end
        end
    end
    local list = {}
    for _, raw in ipairs(rows) do
        local cp = normalizeEntry(raw, idx)
        if cp then
            list[#list + 1] = cp
        end
    end
    return list
end

do
    local idx = buildClassNameIndex()
    CLASS_PROFILES = normalizeArchive(CLASS_ARCHIVE_RAW, idx)
    for _, cp in ipairs(CLASS_PROFILES) do
        CLASS_BY_FOLDER[cp.Folder] = cp
    end
    if #CLASS_PROFILES == 0 then
        warn("[RCWTK] 职业档案为空, 杀戮/技能光环没有职业数据")
    else
        print("[RCWTK] 职业档案已内嵌 (" .. tostring(#CLASS_PROFILES) .. " 个)")
    end
end

function ClassKit.Get(folder)
    return folder and CLASS_BY_FOLDER[folder] or nil
end
function ClassKit.MeleeRange(folder, bowStance)
    local cp = ClassKit.Get(folder)
    if not cp then
        return nil
    end
    if bowStance then
        local r = tonumber(cp.BowRange) or ((tonumber(cp.MeleeRange) or 0) + (tonumber(cp.SpecialRangeBonus) or 0))
        if r > 0 then
            return r
        end
        return nil
    end
    return tonumber(cp.MeleeRange)
end
function ClassKit.ArchiveSkills(folder)
    local cp = ClassKit.Get(folder)
    local sk = cp and cp.Skills
    if type(sk) ~= "table" then
        return nil
    end
    local n = 0
    for i = 1, 4 do
        if sk[i] then
            n = n + 1
        end
    end
    if n == 0 then
        return nil
    end
    return sk
end

local function profileByFolder(folder)
    return ClassKit.Get(folder)
end

local function loadClassSkills(folder)
    local archived = ClassKit.ArchiveSkills(folder)
    local cp = ClassKit.Get(folder)
    if cp and cp.SkipRequire then
        return archived
    end
    local clsDir = ReplicatedStorage.Classes:FindFirstChild(folder)
    if not clsDir then
        return archived
    end
    local sk = clsDir:FindFirstChild("Skills")
    if not sk then
        return archived
    end
    local skills = {}
    for _, mod in ipairs(sk:GetChildren()) do
        if mod:IsA("ModuleScript") then
            local ok, data = pcall(require, mod)
            if ok and type(data) == "table" then
                local n = tostring(data.AnimationName or ""):match("^Ability_(%d+)$")
                local slot = n and tonumber(n)
                if slot and slot >= 1 and slot <= 4 then
                    skills[slot] = data
                end
            end
        end
    end
    local n = 0
    for i = 1, 4 do
        if skills[i] then
            n = n + 1
        end
    end
    if n == 0 then
        return archived
    end
    return skills
end

local _skillCache = { folder = nil, data = nil }
local function cachedClassSkills(folder)
    if _skillCache.folder ~= folder then
        _skillCache = { folder = folder, data = loadClassSkills(folder) }
    end
    return _skillCache.data
end
function ClassKit.Skills(folder)
    return cachedClassSkills(folder)
end

local function skillRange(data)
    if not data then
        return 15
    end
    local r = tonumber(data.HitboxRange)
        or tonumber(data.SpearHitRange)  -- 2026-09-06 实测: 矛 1/3 SpearHitRange=0 是 dash 突刺, 非"无范围"
        or tonumber(data.TickHitboxRange)
        or tonumber(data.AoEHitboxRange)
        or tonumber(data.OpenerRange)
        or tonumber(data.Range)
    if r and r > 0 then
        return r
    end
    local hs = data.HitboxSize or data.TickHitboxSize or data.OpenerHitbox or data.TornadoHitbox
    if typeof(hs) == "Vector3" then
        return math.max(hs.X, hs.Z) / 2
    elseif type(hs) == "table" and (hs.X or hs.Z) then
        return math.max(tonumber(hs.X) or 0, tonumber(hs.Z) or 0) / 2
    end
    return 18  -- dash 型 SpearHitRange=0 的兜底: 仍可贴脸放, 比默认 15 稍大
end

-- ============================================================
-- 覆盖层绘制: 整段落进内层闭包, 对象池 local 不占外层 200 格
-- 新功能优先 TheKing.Draw; 本段是已验证的局内圈/透视/雷达
-- ============================================================
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui", 10)
if not PlayerGui then
    TheKing.Notify({ Title = "绘制", Content = "PlayerGui 等待超时, 透视/圈可能没有", Icon = "alert-triangle" })
end

local Ov = (function()
    local Overlay = Instance.new("ScreenGui")
    Overlay.Name = "TheKing_DrawOverlay"
    Overlay.ResetOnSpawn = false
    Overlay.IgnoreGuiInset = true
    Overlay.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    Overlay.Parent = PlayerGui

    local linePool, barPool, dotPool = {}, {}, {}
    local arrowPool, chestTxtPool = {}, {}
    local curUsedLines, curUsedBars, curUsedDots = 0, 0, 0
    local curUsedArrows, curUsedChestTxts = 0, 0
    local lastUsedLines, lastUsedBars, lastUsedDots = 0, 0, 0
    local lastUsedArrows, lastUsedChestTxts = 0, 0
    local FOOT_Y_OFFSET = -2.2

    local function allocLine()
        local f = Instance.new("Frame")
        f.BackgroundColor3 = Color3.new(1, 1, 1)
        f.BorderSizePixel = 0
        f.AnchorPoint = Vector2.new(0, 0.5)
        f.Visible = false
        f.Parent = Overlay
        return f
    end
    local function allocBar()
        local f = Instance.new("Frame")
        f.BackgroundColor3 = Color3.new(1, 1, 1)
        f.BorderSizePixel = 0
        f.Visible = false
        f.Parent = Overlay
        return f
    end
    local function allocArrow()
        local t = Instance.new("TextLabel")
        t.Text = "▲"
        t.Font = Enum.Font.SourceSansBold
        t.BackgroundTransparency = 1
        t.BorderSizePixel = 0
        t.AnchorPoint = Vector2.new(0.5, 0.5)
        t.Visible = false
        t.Parent = Overlay
        return t
    end
    local function allocChestTxt()
        local t = Instance.new("TextLabel")
        t.Text = "宝箱"
        t.Font = Enum.Font.SourceSansBold
        t.BackgroundTransparency = 1
        t.BorderSizePixel = 0
        t.AnchorPoint = Vector2.new(0.5, 0.5)
        t.TextStrokeTransparency = 0
        t.TextStrokeColor3 = Color3.new(0, 0, 0)
        t.Visible = false
        t.Parent = Overlay
        return t
    end

    local function drawLine(x1, y1, x2, y2, thickness, color, transparency)
        curUsedLines = curUsedLines + 1
        local f = linePool[curUsedLines]
        if not f then
            f = allocLine()
            linePool[curUsedLines] = f
        end
        local dx, dy = x2 - x1, y2 - y1
        local len = math.sqrt(dx * dx + dy * dy)
        if len < 1 then
            len = 1
        end
        f.BackgroundColor3 = color
        f.BackgroundTransparency = transparency
        f.Rotation = math.deg(math.atan2(dy, dx))
        f.Size = UDim2.fromOffset(len, math.max(1, thickness))
        f.Position = UDim2.fromOffset(x1, y1 - thickness / 2)
        f.Visible = true
    end

    local function hideTail(pool, used, last)
        for i = used + 1, last do
            if pool[i] then
                pool[i].Visible = false
            end
        end
    end

    local api = {}
    function api.frameEnd()
        hideTail(linePool, curUsedLines, lastUsedLines)
        hideTail(barPool, curUsedBars, lastUsedBars)
        hideTail(dotPool, curUsedDots, lastUsedDots)
        hideTail(arrowPool, curUsedArrows, lastUsedArrows)
        hideTail(chestTxtPool, curUsedChestTxts, lastUsedChestTxts)
        lastUsedLines, lastUsedBars, lastUsedDots = curUsedLines, curUsedBars, curUsedDots
        lastUsedArrows, lastUsedChestTxts = curUsedArrows, curUsedChestTxts
        curUsedLines, curUsedBars, curUsedDots = 0, 0, 0
        curUsedArrows, curUsedChestTxts = 0, 0
    end
    function api.reset()
        for _, pool in ipairs({ linePool, barPool, dotPool, arrowPool, chestTxtPool }) do
            for _, f in ipairs(pool) do
                f.Visible = false
            end
        end
        lastUsedLines, lastUsedBars, lastUsedDots = 0, 0, 0
        lastUsedArrows, lastUsedChestTxts = 0, 0
        curUsedLines, curUsedBars, curUsedDots = 0, 0, 0
        curUsedArrows, curUsedChestTxts = 0, 0
    end
    function api.takeChestTxt()
        curUsedChestTxts = curUsedChestTxts + 1
        local t = chestTxtPool[curUsedChestTxts]
        if not t then
            t = allocChestTxt()
            chestTxtPool[curUsedChestTxts] = t
        end
        return t
    end
    function api.takeArrow()
        curUsedArrows = curUsedArrows + 1
        local t = arrowPool[curUsedArrows]
        if not t then
            t = allocArrow()
            arrowPool[curUsedArrows] = t
        end
        return t
    end
    function api.ring(hrp, radius, color, transparency, opts)
        local cam = workspace.CurrentCamera
        if not cam then
            return
        end
        opts = opts or {}
        local yOff = opts.yOff or FOOT_Y_OFFSET
        local center = hrp.Position + Vector3.new(0, yOff, 0)
        local s0 = cam:WorldToScreenPoint(center)
        local sumR, nR = 0, 0
        for k = 0, 3 do
            local a = k * math.pi / 2
            local sp = cam:WorldToScreenPoint(center + Vector3.new(math.cos(a) * radius, 0, math.sin(a) * radius))
            if s0.Z > 0 and sp.Z > 0 then
                sumR = sumR + ((sp.X - s0.X) ^ 2 + (sp.Y - s0.Y) ^ 2) ^ 0.5
                nR = nR + 1
            end
        end
        local scrR = nR > 0 and (sumR / nR) or 30
        if scrR < (opts.minScr or 4) then
            return
        end
        local segs = math.clamp(math.floor(2 * math.pi * scrR / 7), opts.minSegs or 24, opts.maxSegs or 220)
        local pts = {}
        local anyF = false
        for i = 1, segs do
            local a = (i - 1) / segs * math.pi * 2
            local sp = cam:WorldToScreenPoint(center + Vector3.new(math.cos(a) * radius, 0, math.sin(a) * radius))
            pts[i] = sp
            if sp.Z > 0 then
                anyF = true
            end
        end
        if not anyF then
            return
        end
        local th = opts.thickness or 2
        for i = 1, segs do
            local p1 = pts[i]
            local p2 = pts[(i % segs) + 1]
            if p1.Z > 0 and p2.Z > 0 then
                local dx, dy = p2.X - p1.X, p2.Y - p1.Y
                local len = math.sqrt(dx * dx + dy * dy)
                if len > 0.5 then
                    local ex, ey = dx / len * 2, dy / len * 2
                    drawLine(p1.X - ex, p1.Y - ey, p2.X + ex, p2.Y + ey, th, color, transparency)
                end
            end
        end
    end
    TheKing.OnCleanup(function()
        pcall(function()
            Overlay:Destroy()
        end)
    end)
    api.gui = Overlay
    return api
end)()

-- ============================================================
-- Tab: 战斗
-- ============================================================
local BattleTab = TheKing.NewTab({ Title = "战斗", Icon = "swords" })

-- 平A距离: 跟当前武器形态走。锻造霸主 3技能切弓 / 4技能切回近战 (看左手 Bow 透明度)
-- 未挥击时 Hitbox 是占位 (Size≈0.05, C0.Z=-Range/2), 真实距离 = 2*|C0.Z|, 不能用 Size.Z/2
local _meleeRangeCache = { t = 0, v = 12, cls = nil, bow = false, clsR = nil }
local function isForgeBowStance()
    local cls = LocalPlayer:GetAttribute("Current_Class") or LocalPlayer:GetAttribute("Active_Class")
    if cls ~= "Forge Archon" then
        return false
    end
    local char = getChar()
    if not char then
        return false
    end
    local bow = char:FindFirstChild("Bow", true)
    if bow and bow:IsA("BasePart") then
        return bow.Transparency < 0.5
    end
    local ls = char:FindFirstChild("LeftSword", true)
    if ls and ls:IsA("BasePart") then
        return ls.Transparency > 0.5
    end
    return false
end
local function classDefAttackRange(className, bowStance)
    if not className then
        return nil
    end
    if _meleeRangeCache.cls == className and _meleeRangeCache.bow == bowStance and _meleeRangeCache.clsR then
        return _meleeRangeCache.clsR
    end
    local r = ClassKit.MeleeRange(className, bowStance)
    if not r then
        local folder = ReplicatedStorage.Classes:FindFirstChild(className)
        local defMod = folder and folder:FindFirstChild("Definition")
        if defMod then
            local ok, def = pcall(require, defMod)
            if ok and type(def) == "table" then
                r = tonumber(def.Range)
                if bowStance then
                    r = (r or 0) + (tonumber(def.SpecialRangeBonus) or 0)
                    if r <= 0 then
                        r = nil
                    end
                end
            end
        end
    end
    _meleeRangeCache.cls = className
    _meleeRangeCache.bow = bowStance
    _meleeRangeCache.clsR = r
    return r
end
local function liveHitboxReach()
    local char = getChar()
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then
        return nil
    end
    local best = nil
    local function consider(p)
        if not (p and p.Name == "Hitbox" and p:IsA("BasePart")) then
            return
        end
        local sz = p.Size
        local off = 0
        local weld = p:FindFirstChild("Hitbox_Weld")
        if weld and weld:IsA("Weld") then
            off = math.abs(weld.C0.Position.Z)
        else
            local look = Vector3.new(hrp.CFrame.LookVector.X, 0, hrp.CFrame.LookVector.Z)
            if look.Magnitude > 0.01 then
                look = look.Unit
                local d = p.Position - hrp.Position
                off = math.abs(d.X * look.X + d.Z * look.Z)
            end
        end
        local szZ = math.abs(sz.Z)
        -- 占位盒: Weapon_Manager 闲置 Size≈0.05, C0 = (0,0,-Range/2)
        local reach = (szZ < 1) and (off * 2) or (off + szZ / 2)
        if reach > 1.5 and (not best or reach > best) then
            best = reach
        end
    end
    consider(hrp:FindFirstChild("Hitbox"))
    for _, ch in ipairs(hrp:GetChildren()) do
        consider(ch)
    end
    consider(char:FindFirstChild("Hitbox"))
    return best
end
local function getMeleeRange()
    local now = os.clock()
    local bow = isForgeBowStance()
    if now - _meleeRangeCache.t < 0.12 and _meleeRangeCache.bow == bow then
        return _meleeRangeCache.v
    end
    local cls = LocalPlayer:GetAttribute("Current_Class") or LocalPlayer:GetAttribute("Active_Class")
    local fromBox = liveHitboxReach()
    local fromDef = classDefAttackRange(cls, bow)
    local v
    if bow then
        -- 切弓瞬间闲置 Hitbox 可能还是近战 Range, 信档案 BowRange
        v = fromDef or fromBox or 26
        if fromBox and fromBox > v then
            v = fromBox
        end
    else
        -- 档案 Range 是闲置权威距离; 挥击中盒更长才跟盒, 占位盒(≈Range)不覆盖档案
        v = fromDef or fromBox or 12
        if fromBox and fromDef and fromBox > fromDef + 1.5 then
            v = fromBox
        end
    end
    v = math.clamp(v, 4, 50)
    _meleeRangeCache.t = now
    _meleeRangeCache.v = v
    _meleeRangeCache.bow = bow
    return v
end
do
    local conn = LocalPlayer.CharacterAdded:Connect(function()
        _meleeRangeCache.t = 0
        _meleeRangeCache.v = 12
        _meleeRangeCache.cls = nil
        _meleeRangeCache.clsR = nil
        _meleeRangeCache.bow = false
    end)
    TheKing.AddConnection(conn)
end

-- ---- 自动喝血: 开关在阈值之上 ----
local potionPct = PREF.potionPct or 50

TheKing.BindToggle(BattleTab, {
    Title = "自动喝血药水",
    Flag = "dr_potion",
    Interval = 0.6,
    OnTick = function()
        local hum = getHum()
        if not hum then
            return
        end
        local hp, maxHp = hum.Health, hum.MaxHealth
        if maxHp <= 0 or hp <= 0 then
            return
        end
        if (hp / maxHp) * 100 >= potionPct then
            return
        end
        local svc = Knit.GetService("PotionService")
        local ok = pcall(function()
            local p = svc:UsePotion(1)
            if p and p.await then
                p:await()
            end
        end)
        if not ok then
            TheKing.Notify({ Title = "自动喝血", Content = "喝药请求失败", Icon = "alert-triangle" })
            TheKing.Backoff(3)
        end
    end,
})

BattleTab:Slider({
    Title = "血量百分比阈值",
    Value = { Min = 5, Max = 95, Default = PREF.potionPct or 50 },
    Step = 5,
    Callback = function(v)
        potionPct = v
        PREF.potionPct = v
        prefSave()
    end,
})

-- ---- 杀戮光环: 开关在范围滑条之上, 360° 锁怪 ----
-- 攻击连击引擎 (照抄客户端 Weapon_Input.hookAttackCadence):
-- 真人持按 = 每击攻击动画播放到内嵌 "DBreset" marker 时自动接下一击 -> 无缝连砍
-- 本引擎 hook Animator.AnimationPlayed("Animation") + GetMarkerReachedSignal("DBreset")
-- 技能要释放时 (skillPending 非空) 自动断链 -> 动画自然停止 -> 空窗内插技能
local ATK_ANIM_NAME = "Animation"
local atkAnim = { isAttacking = false, curTrack = nil, endAt = 0 }
local meleeEnabled = false
local meleeLastAttack = 0
local skillHoldUntil = 0 -- 技能释放时间窗: 期间平A让路
local autoRotateLockUntil = 0 -- 平A锁朝向: 防 WASD 把脸转走
local skillPending = nil -- { slot=, target=, createdAt= } (前向声明, 供 fireMeleeOnce 判断断链)
local skillCursor = 0 -- 公平轮转游标: 每次从上次释放槽的下一个开始找, 保证 3/4 也能轮到
local skillBusyUntil = 0 -- 技能侧节流: 发技能后等服务端动作处理 (长技能动画自动延展)
local skillAuraOn = false -- (前向声明, fireMeleeOnce 技能优先 gate 用)
local neverUlt = false -- 永不使用终极技能 (开关 gate findReadySkill 的 E 槽)
local skillDumpSlot = nil -- 充能技打空当前槽前不换技能
local skillRestUntil = 0 -- 一段技能打完后给平A接刀的窗口
local skillFreezeMove = false -- 仅位移技 (Dash/升空) 才禁 WalkSpeed; 弓手技能禁走会抽搐
local findReadySkill = nil -- (前向声明, 定义在技能调度区: 返回 {slot,target} 或 nil)
local autoApproachAt = 0 -- 近战双光环贴脸节流
-- 战斗锁定收进一张表, 少占主块 local 寄存器 (Luau 上限 200)
local Cbt = {
    lock = nil,
    _wsWasFreeze = false,
    blessUiAt = 0,
    blessFireAt = 0,
    _parryAt = 0,
    _parryScanAt = 0,
    _refillScanAt = 0,
    refillFireAt = 0,
    _dodgeT0 = 0,
    _dodgeFadeAt = 0,
    kiteAt = 0,
    kiteKey = "",
    kiting = false,
    _atkIntAt = 0,
    _atkInt = 0.099,
    twistUntil = 0,
    twistCenter = nil,
    twistAng = 0,
    twistTickAt = 0,
    aoeDodgeOn = PREF.t_dr_aoe_dodge ~= 0,
    BurstRad = 16,
    _burstZones = {},
    _burstHooked = false,
}
-- 平A间隔: 职业 AttackSpeed × (1 + 装备/成就攻速%/100). Stat_AttackSpeed 上限 60 (StatInfoData Cap)
function Cbt.atkInterval()
    local now = os.clock()
    if now - (Cbt._atkIntAt or 0) < 0.4 and (Cbt._atkInt or 0) > 0 then
        return Cbt._atkInt
    end
    local classSpd = 1
    local cur = LocalPlayer:GetAttribute("Current_Class") or LocalPlayer:GetAttribute("Active_Class")
    if type(cur) == "string" and cur ~= "" then
        for i = 1, #CLASS_PROFILES do
            local p = CLASS_PROFILES[i]
            if p and p.Folder == cur then
                classSpd = tonumber(p.AtkSpd) or 1
                break
            end
        end
    end
    if classSpd < 0.4 then
        classSpd = 0.4
    end
    local gear = tonumber(LocalPlayer:GetAttribute("Stat_AttackSpeed")) or 0
    local ach = tonumber(LocalPlayer:GetAttribute("AchBoost_AttackSpeed")) or 0
    if gear < 0 then
        gear = 0
    elseif gear > 60 then
        gear = 60
    end
    if ach < 0 then
        ach = 0
    end
    local mult = classSpd * (1 + (gear + ach) / 100)
    if mult < 0.5 then
        mult = 0.5
    elseif mult > 3.5 then
        mult = 3.5
    end
    Cbt._atkInt = 0.099 / mult
    Cbt._atkIntAt = now
    return Cbt._atkInt
end
function Cbt.alive(en)
    if not (en and en.model and en.model.Parent) then
        return false
    end
    if en.model:GetAttribute("Dead") or en.model:GetAttribute("IsDormant") then
        return false
    end
    if Players:GetPlayerFromCharacter(en.model) then
        return false
    end
    local hrp = en.hrp
    if not (hrp and hrp.Parent) then
        return false
    end
    return true
end
function Cbt.mark(en)
    if en and Cbt.alive(en) then
        Cbt.lock = en
    end
end
function Cbt.isRanged()
    if isForgeBowStance() then
        return true
    end
    local cls = LocalPlayer:GetAttribute("Current_Class") or LocalPlayer:GetAttribute("Active_Class")
    local cp = ClassKit.Get(cls)
    if cp and cp.Ranged == true then
        return true
    end
    local r = ClassKit.MeleeRange(cls, false)
    return (tonumber(r) or 0) >= 26
end
-- 近战贴脸半径: 档案射程的一半 (下限 8)。怪在圈边/圈外一点点时旧逻辑会索到并空放技能。
-- 远程职业仍用满射程 (kite 自己拉开)。
function Cbt.engageRange(full)
    full = tonumber(full) or 16
    if full < 1 then
        full = 16
    end
    if Cbt.isRanged() then
        return full
    end
    return math.max(full * 0.5, 8)
end
function Cbt.skillFireRange(data)
    local full = skillRange(data)
    if Cbt.isRanged() then
        return full + 8
    end
    -- 倒置长矛: 半半径太贴, 技能好了还在走位不放; 0.8 满射程能出手, 贴脸仍走 engage 半半径
    local cp = CLASS_PROFILES[classIdx]
    if cp and cp.DualForm then
        return math.max(full * 0.8, 12)
    end
    return Cbt.engageRange(full)
end
function Cbt.kiteMove(hum, dest)
    if not (hum and dest) then
        return
    end
    local now = os.clock()
    local gk = string.format("%.0f:%.0f", dest.X, dest.Z)
    if Cbt.kiteKey == gk and (now - (Cbt.kiteAt or 0)) < 0.55 then
        return
    end
    Cbt.kiteKey = gk
    Cbt.kiteAt = now
    pcall(function()
        hum:MoveTo(dest)
    end)
end
-- Nav 前向声明: Nav 真正初始化在下方寻路区 (~2850), 不提前声明的话
-- kiteTick 捕获的是全局 Nav (nil), 远程风筝循环会每帧炸 "index nil with 'on'"
local Nav = {}
function Cbt.kiteTick()
    Cbt.kiting = false
    if not hubAlive or not (meleeEnabled or skillAuraOn) then
        return
    end
    if not Cbt.isRanged() then
        return
    end
    if LocalPlayer:GetAttribute("Dead") then
        return
    end
    local now = os.clock()
    if now < skillBusyUntil and skillFreezeMove then
        return
    end
    if Nav.on then
        if Nav.steering or Nav.userDriving() then
            return
        end
        local ph = Nav.phase
        if ph == "loot" or ph == "refill" or ph == "hall" or ph == "seek" or ph == "center" or ph == "boss" or ph == "done" then
            return
        end
    end
    local hrp = getHRP()
    local hum = getHum()
    if not (hrp and hum) or hum.Health <= 0 then
        return
    end
    local pos = hrp.Position
    local reach = getMeleeRange()
    local hold = math.clamp(reach * 0.58, 14, math.max(16, reach - 5))
    local tooClose = math.clamp(reach * 0.34, 9, 15)
    local nearest, nearD = nil, 1e9
    local packX, packZ, packN = 0, 0, 0
    local crowd = 0
    for _, en in ipairs(getEnemies()) do
        if Cbt.alive(en) then
            local p = en.hrp.Position
            local d = (p - pos).Magnitude
            if d < 70 then
                packX = packX + p.X
                packZ = packZ + p.Z
                packN = packN + 1
                if d < nearD then
                    nearD = d
                    nearest = en
                end
                if d < 12 then
                    crowd = crowd + 1
                end
            end
        end
    end
    if not nearest then
        return
    end
    Cbt.kiting = true
    local pack = pos
    if packN > 0 then
        pack = Vector3.new(packX / packN, pos.Y, packZ / packN)
    end
    local away = Vector3.new(pos.X - pack.X, 0, pos.Z - pack.Z)
    if away.Magnitude < 0.8 then
        away = Vector3.new(pos.X - nearest.hrp.Position.X, 0, pos.Z - nearest.hrp.Position.Z)
    end
    if away.Magnitude < 0.4 then
        local look = Vector3.new(-hrp.CFrame.LookVector.X, 0, -hrp.CFrame.LookVector.Z)
        away = look.Magnitude > 0.2 and look or Vector3.new(1, 0, 0)
    end
    away = away.Unit
    local room = getCurrentRoom()
    local function tryDest(dir, dist)
        local x = pos.X + dir.X * dist
        local z = pos.Z + dir.Z * dist
        local dest = Nav.groundAt(x, z, pos.Y)
        if room and not Nav.inZone(room, dest) then
            return nil
        end
        local climb = math.abs(dest.Y - pos.Y)
        if climb > 4.5 then
            return nil
        end
        return dest
    end
    local function sidestep(dir, dist)
        local d = tryDest(dir, dist)
        if d then
            return d
        end
        local r = Vector3.new(-dir.Z, 0, dir.X)
        d = tryDest(r, dist)
        if d then
            return d
        end
        return tryDest(-r, dist)
    end
    if Nav.on and Nav.pathLive() then
        Nav.pts = {}
        Nav.idx = 1
        Nav.clearMarks()
    end
    if nearD < tooClose or crowd >= 2 then
        local step = math.clamp(hold - nearD + 6, 8, 16)
        local dest = sidestep(away, step)
        if dest then
            Cbt.kiteMove(hum, dest)
        end
        return
    end
    if nearD > hold + 3 then
        local to = Vector3.new(nearest.hrp.Position.X - pos.X, 0, nearest.hrp.Position.Z - pos.Z)
        if to.Magnitude > 0.4 then
            local walk = math.max(0, nearD - hold)
            local dest = sidestep(to.Unit, math.min(walk, 14))
            if dest then
                Cbt.kiteMove(hum, dest)
            end
        end
        return
    end
    Cbt.kiteKey = ""
    pcall(function()
        hum:MoveTo(pos)
    end)
end
function Cbt.syncKite()
    if hubAlive and (meleeEnabled or skillAuraOn) then
        TheKing.StartLoop("dr_ranged_kite", 0.12, Cbt.kiteTick)
    else
        TheKing.StopLoop("dr_ranged_kite")
        Cbt.kiting = false
        Cbt.kiteKey = ""
    end
end
-- 有锁就关 AutoRotate: WASD 只平移不扭脸; 扭脸保留速度
function Cbt.lockFace()
    if not (hubAlive and meleeEnabled) then
        TheKing.UnbindStepped("dr_melee_lock")
        return
    end
    TheKing.BindStepped("dr_melee_lock", "heartbeat", function()
        if not (hubAlive and meleeEnabled) then
            return
        end
        local hrp = getHRP()
        local hum = getHum()
        if not (hrp and hum) or hum.Health <= 0 then
            return
        end
        local tgt = Cbt.lock
        if tgt and Cbt.alive(tgt) then
            if hum.AutoRotate ~= false then
                pcall(function()
                    hum.AutoRotate = false
                end)
            end
            local want = flatDir(hrp.Position, tgt.hrp.Position)
            local look = Vector3.new(hrp.CFrame.LookVector.X, 0, hrp.CFrame.LookVector.Z)
            if want.Magnitude > 0.05 and (look.Magnitude < 0.05 or look.Unit:Dot(want) < 0.995) then
                faceTowards(hrp, tgt.hrp.Position)
            end
        else
            if hum.AutoRotate ~= true then
                pcall(function()
                    hum.AutoRotate = true
                end)
            end
        end
    end)
end
-- v1.17.0 爬塔 Boss 波"清杂优先": 塔内 Boss 在场且场上还有活小怪 → true。
-- 期间平A索敌/追击贴怪都跳过 Boss、优先咬小怪, 小怪清光自动转集火 Boss。
-- Boss 集 = Cbt.isBossModel (IsBoss/IsMiniBoss/HighlightPriority/精英/名册), 其余活怪 = 小怪。
-- 0.5s 缓存防每 tick 全扫; 塔外恒 false (普通 dungeon Boss 房不受影响)。
function Cbt.addsFirst()
    if not (Nav.on and Nav.isTowerRun()) then
        Cbt._addsAt = nil
        return false
    end
    local now = os.clock()
    if Cbt._addsAt and now - Cbt._addsAt < 0.5 then
        return Cbt._addsVal
    end
    local hasBoss, hasAdd = false, false
    for _, en in ipairs(getEnemies()) do
        if Cbt.alive(en) then
            if Cbt.isBossModel(en.model) then
                hasBoss = true
            else
                hasAdd = true
            end
            if hasBoss and hasAdd then
                break
            end
        end
    end
    Cbt._addsAt = now
    Cbt._addsVal = hasBoss and hasAdd
    return Cbt._addsVal
end
function Cbt.pick(range)
    local hrp = getHRP()
    if not (hrp and range and range > 0) then
        return nil
    end
    local pos = hrp.Position
    if Cbt.lock and not Cbt.alive(Cbt.lock) then
        Cbt.lock = nil
        getEnemies(true)
    end
    -- v1.17.0: 塔 Boss 波锁若咬在 Boss 上且场上还有活小怪 → 丢锁重选 (小怪优先)
    if Cbt.lock and Cbt.addsFirst() and Cbt.isBossModel(Cbt.lock.model) then
        Cbt.lock = nil
        getEnemies(true)
    end
    local look = hrp.CFrame.LookVector
    look = Vector3.new(look.X, 0, look.Z)
    if look.Magnitude > 0.05 then
        look = look.Unit
    else
        look = nil
    end
    -- 粘性: 锁还在射程内、大体朝它、且没有明显更近的才继续; 否则重选, 避免圈在东边刀在西边
    if Cbt.lock then
        local d = (Cbt.lock.hrp.Position - pos).Magnitude
        if d <= range * 1.12 then
            local keep = true
            local toLock = Vector3.new(Cbt.lock.hrp.Position.X - pos.X, 0, Cbt.lock.hrp.Position.Z - pos.Z)
            if look and toLock.Magnitude > 0.4 and look:Dot(toLock.Unit) < 0.22 then
                keep = false
            end
            if keep then
                for _, en in ipairs(getEnemies()) do
                    if Cbt.alive(en) and en.model ~= Cbt.lock.model then
                        local d2 = (en.hrp.Position - pos).Magnitude
                        if d2 <= range and d2 + 3.5 < d then
                            keep = false
                            break
                        end
                    end
                end
            end
            if keep then
                return Cbt.lock
            end
        end
    end
    local best, bestS = nil, 1e9
    for _, en in ipairs(getEnemies()) do
        if Cbt.alive(en) then
            local d = (en.hrp.Position - pos).Magnitude
            if d <= range then
                local s = d
                local hum = en.model:FindFirstChildOfClass("Humanoid")
                local frac = (hum and hum.MaxHealth > 1) and (hum.Health / hum.MaxHealth) or 1
                if frac < 0.32 then
                    s = s - 5
                elseif frac < 0.55 then
                    s = s - 2
                end
                if Cbt.isBossModel(en.model) then
                    -- v1.17.0: 爬塔 Boss 波 (每10层) 小怪优先 — boss 场上有活杂兵时沉底, 清完才集火
                    if Cbt.addsFirst() then
                        s = s + 75
                    else
                        s = s - 2.2
                    end
                end
                if look then
                    local to = Vector3.new(en.hrp.Position.X - pos.X, 0, en.hrp.Position.Z - pos.Z)
                    if to.Magnitude > 0.4 then
                        s = s - look:Dot(to.Unit) * 1.8
                    end
                end
                if Cbt.lock and en.model == Cbt.lock.model then
                    s = s - 4
                end
                if s < bestS then
                    bestS = s
                    best = en
                end
            end
        end
    end
    Cbt.lock = best
    return best
end

local function findMeleeTarget(range)
    return Cbt.pick(range)
end
function Cbt.disc(key, adornee, radius, color, trans, yOff)
    local a = Cbt[key]
    if not (a and a.Parent) then
        a = Instance.new("CylinderHandleAdornment")
        a.Name = "TK_" .. key
        a.AlwaysOnTop = true
        a.ZIndex = 10
        a.Height = 0.12
        a.Parent = Ov.gui
        Cbt[key] = a
    end
    if not (adornee and radius and radius > 0.2) then
        a.Visible = false
        return
    end
    a.Adornee = adornee
    a.Radius = radius
    a.Color3 = color
    a.Transparency = trans or 0.4
    a.CFrame = CFrame.new(0, yOff or -2.45, 0) * CFrame.Angles(math.pi / 2, 0, 0)
    a.Visible = true
end
-- 发一击: 技能优先 + 技能排队/窗口期间停发 (双光环时平A只补技能真空)
-- 近战双光环贴脸: 范围内无怪但附近有怪 → 朝最近怪 MoveTo 小步接近
-- 仅在杀戮+技能双开时补位 (单开保持原行为), 让技能/平A 光环尽快咬住怪, 减少站桩空转
function Cbt.autoApproach()
    local hrp = getHRP()
    local hum = getHum()
    if not (hrp and hum) or hum.Health <= 0 then
        return
    end
    -- 踩在爆炸预警圆里时别 MoveTo 贴脸, 否则闪出去又被走回来
    if os.clock() < (Cbt._aoeUntil or 0) then
        return
    end
    if Nav.on and (Nav.steering or Nav.userDriving()) then
        return
    end
    -- 聚怪旋转 (无限核心 Blue 等 PullSlot 职业): 绕奇点圆周走位, 把周围怪拖成一堆
    -- 蓝的拖拽把怪往奇点吸, 绕圈=把不同方向的怪全带过来; 到点/怪没了自动停
    local nowT = os.clock()
    if nowT < (Cbt.twistUntil or 0) then
        local center = Cbt.twistCenter
        if center and center.Parent then
            -- 走位 tick 0.12s 一次 (MoveTo 节流), 角速度 ~3.2 rad/s 半径 8 格
            if nowT - (Cbt.twistTickAt or 0) >= 0.12 then
                Cbt.twistTickAt = nowT
                Cbt.twistAng = (Cbt.twistAng or 0) + 0.38
                local cpos = center.Position
                local dest = Vector3.new(cpos.X + math.cos(Cbt.twistAng) * 8, hrp.Position.Y, cpos.Z + math.sin(Cbt.twistAng) * 8)
                pcall(function()
                    hum:MoveTo(dest)
                end)
                faceTowards(hrp, cpos)
            end
            return
        end
        Cbt.twistUntil = 0
    elseif Cbt.twistUntil and Cbt.twistUntil > 0 then
        Cbt.twistUntil = 0
        Cbt.twistCenter = nil
    end
    if LocalPlayer:GetAttribute("Dead") then
        return
    end
    local reach = getMeleeRange()
    local commit = Cbt.engageRange(reach)
    -- 爬塔拾箱优先级 (波次无间断出怪, 有箱先全捡): 拾箱走位期间追击让位, 唯一例外 pick 命中
    -- (贴脸怪还是要打 — 杀出脱困空间); 平A不受影响, 范围内有怪照常出刀
    if Nav.towerPicking then
        if Cbt.pick(commit) then
            Cbt.approachKey = ""
            return
        end
        return
    end
    -- 近战: 半半径内已有怪才停步让光环打; 只在满射程边缘不算贴脸 (v1.17.1)
    if Cbt.pick(commit) then
        Cbt.approachKey = ""
        return
    end
    local now = os.clock()
    if now < skillBusyUntil and skillFreezeMove then
        return
    end
    -- 追击半径: 寻路跑着 (普通图 fight 等阶段) 用 25 让寻路管走位; 爬塔/无寻路 60 格
    -- — 远程怪站 30+ 格外也能追到 (爬塔竞技场全图 <100 格)
    local scanR = (Nav.on and Nav.isTowerRun()) and 60 or 25
    local best, bd = nil, scanR
    -- v1.17.0: 爬塔 Boss 波贴怪优先选杂兵 (Boss 有活小怪时不主动凑上去)
    local trashFirst = Cbt.addsFirst()
    for _, en in ipairs(getEnemies()) do
        if Cbt.alive(en) and not en.model:GetAttribute("IsDormant") then
            if not (trashFirst and Cbt.isBossModel(en.model)) then
                local d = (en.hrp.Position - hrp.Position).Magnitude
                if d < bd then
                    bd = d
                    best = en
                end
            end
        end
    end
    if not best then
        Cbt.approachKey = ""
        return
    end
    Cbt.mark(best)
    -- 走到半半径处再停 (旧 reach*0.7 仍在圈边, 倒置长矛技能经常挥空)
    local stop = commit
    if bd <= stop then
        Cbt.approachKey = ""
        return
    end
    local dir = (best.hrp.Position - hrp.Position)
    dir = Vector3.new(dir.X, 0, dir.Z)
    if dir.Magnitude < 0.3 then
        return
    end
    local dest = hrp.Position + dir.Unit * (bd - stop)
    local gk = string.format("%.0f:%.0f", dest.X, dest.Z)
    if Cbt.approachKey == gk and now - (Cbt.approachAt or 0) < 0.5 then
        return
    end
    Cbt.approachKey = gk
    Cbt.approachAt = now
    pcall(function()
        hum:MoveTo(dest)
    end)
end
-- 发一击本体: 技能优先 + 技能排队/窗口期间停发
local function fireMeleeOnce()
    local hrp = getHRP()
    local hum = getHum()
    if not (hrp and hum) or hum.Health <= 0 then
        return
    end
    -- 猛攻调度: 技能/终极 CD 好了先停平A, 交技能光环 tick 立刻发 (findReadySkill 校验就绪)
    -- 找不到可发技能自然回落平A, 不影响节奏
    if skillAuraOn and findReadySkill then
        local now0 = os.clock()
        if now0 >= skillBusyUntil and findReadySkill(now0) then
            return
        end
    end
    local now = os.clock()
    if now < skillHoldUntil then
        return
    end
    if now < skillBusyUntil and skillFreezeMove then
        return
    end
    -- 平A节奏: 职业攻速 × 装备 Stat_AttackSpeed%; DBreset 补发更密时固定 0.1 会漏刀
    if now - meleeLastAttack < Cbt.atkInterval() then
        return
    end
    local tgt = findMeleeTarget(getMeleeRange())
    if not tgt then
        return
    end
    Cbt.mark(tgt)
    local to = tgt.hrp.Position - hrp.Position
    to = Vector3.new(to.X, 0, to.Z)
    local aim = Vector3.zero
    if to.Magnitude > 0.15 then
        aim = to.Unit
        faceTowards(hrp, tgt.hrp.Position)
    end
    -- 游戏本体平A发的是相机相对 WASD; 发 zero 时服务端会跟走位. 这里发指向锁定的世界方向
    Cbt.lastFireAt = now
    Cbt.lastFireSlot = "A"
    TheKing.Fire(AttackRE, aim)
    meleeLastAttack = now
end

local function hookAttackAnim(char)
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local anim = hum and hum:FindFirstChildOfClass("Animator")
    if not anim then
        return
    end
    local conn = anim.AnimationPlayed:Connect(function(track)
        -- 全程 pcall: 动画对象在角色重生/销毁时访问可能抛错, 不外泄刷屏
        pcall(function()
            local an = track.Animation
            local anName = an and an.Name or ""
            local len = (track.Length or 0.7) / math.max(track.Speed, 0.5)
            if anName:match("^Ability_") then
                -- 技能动画不拉长 busy/hold: Stormfire 等多段 Ability_ 会把平A和后续技能锁死
            elseif anName == ATK_ANIM_NAME and track.Speed >= 0.8 then
                atkAnim.isAttacking = true
                atkAnim.curTrack = track
                atkAnim.endAt = os.clock() + 0.15 + len
                local okM, dbr = pcall(function()
                    return track:GetMarkerReachedSignal("DBreset")
                end)
                if okM and dbr then
                    local mConn = dbr:Connect(function()
                        if meleeEnabled then
                            fireMeleeOnce()
                        end
                    end)
                    track.Stopped:Once(function()
                        pcall(function()
                            mConn:Disconnect()
                        end)
                        if atkAnim.curTrack == track then
                            atkAnim.isAttacking = false
                            atkAnim.curTrack = nil
                        end
                    end)
                end
            end
        end)
    end)
    TheKing.AddConnection(conn)
end
do
    local c0 = getChar()
    if c0 then
        hookAttackAnim(c0)
    end
    local connA = LocalPlayer.CharacterAdded:Connect(function(ch)
        hookAttackAnim(ch)
    end)
    TheKing.AddConnection(connA)
end
local function attackAnimBusy()
    local t = atkAnim.curTrack
    if t and t.IsPlaying then
        return true
    end
    atkAnim.isAttacking = false
    atkAnim.curTrack = nil
    return os.clock() < atkAnim.endAt
end

-- ---- 内置拼刀: 平A/技能光环开着就对精英和 Boss 出招窗点 Parry, 不拼小怪 ----
function Cbt.bossIndex()
    local idx = Cbt._bossIdx
    if type(idx) == "table" then
        return idx
    end
    idx = {}
    local mod = ReplicatedStorage:FindFirstChild("GameInfo")
    mod = mod and mod:FindFirstChild("Boss_ActionData")
    if mod then
        local ok, data = pcall(require, mod)
        if ok and type(data) == "table" then
            if type(data.Index) == "table" then
                idx = data.Index
            end
            Cbt._bossResolve = data.Resolve
        end
    end
    Cbt._bossIdx = idx
    return idx
end
function Cbt.bossRow(model)
    if not model then
        return nil
    end
    local id = model:GetAttribute("ItemId") or model.Name
    local idx = Cbt.bossIndex()
    local row = idx[id]
    if not row and type(Cbt._bossResolve) == "function" then
        local ok, r = pcall(Cbt._bossResolve, id)
        if ok and type(r) == "table" then
            row = r
        end
    end
    return row, id
end
function Cbt.isBossModel(model)
    if not model then
        return false
    end
    if model:GetAttribute("IsDormant") then
        return false
    end
    if model:GetAttribute("Dead") then
        return false
    end
    if model:GetAttribute("IsBoss") or model:GetAttribute("IsMiniBoss") then
        return true
    end
    local pri = tonumber(model:GetAttribute("HighlightPriority")) or 0
    if pri > 0 then
        return true
    end
    if model:GetAttribute("IsElite") == true or model:GetAttribute("Elite") == true then
        return true
    end
    if Cbt.bossRow(model) then
        return true
    end
    -- 收紧: 无任何 Boss/精英标记的怪不拼刀 (旧兜底 return true 会把普通怪也当 Boss 频繁格挡)
    return false
end
function Cbt.parrySkipAnim(name)
    if type(name) ~= "string" or name == "" then
        return true
    end
    local l = string.lower(name)
    if string.find(l, "unblock", 1, true) then
        return true
    end
    if string.find(l, "parry", 1, true) or string.find(l, "block", 1, true) then
        return true
    end
    if string.find(l, "idle", 1, true) or string.find(l, "walk", 1, true) or string.find(l, "run", 1, true) then
        return true
    end
    if string.find(l, "stun", 1, true) or string.find(l, "hit_reaction", 1, true) or string.find(l, "death", 1, true) then
        return true
    end
    if string.find(l, "jump", 1, true) or string.find(l, "spawn", 1, true) or string.find(l, "emote", 1, true) then
        return true
    end
    return false
end
function Cbt.parryWantAnim(name)
    if Cbt.parrySkipAnim(name) then
        return false
    end
    if name == "Animation" or string.sub(name, 1, 7) == "Attack_" or string.sub(name, 1, 8) == "Ability_" then
        return true
    end
    local l = string.lower(name)
    if string.find(l, "slash", 1, true) or string.find(l, "swing", 1, true) or string.find(l, "combo", 1, true) then
        return true
    end
    if string.find(l, "string", 1, true) or string.find(l, "smash", 1, true) or string.find(l, "cleave", 1, true) then
        return true
    end
    if string.find(l, "attack", 1, true) or string.find(l, "strike", 1, true) or string.find(l, "slam", 1, true) then
        return true
    end
    if string.find(l, "lunge", 1, true) or string.find(l, "stab", 1, true) or string.find(l, "punch", 1, true) then
        return true
    end
    return false
end
function Cbt.parryDelay(row, animName)
    local w = tonumber(row and row.WindUpDuration) or 0.18
    local spd = tonumber(row and row.CombatSpeed) or 1
    if type(animName) == "string" and row and type(row.Abilities) == "table" then
        for _, ab in ipairs(row.Abilities) do
            if type(ab) == "table" then
                local an = ab.AnimName
                if type(an) == "string" and an ~= "" and string.find(animName, an, 1, true) then
                    w = tonumber(ab.TelegraphDuration) or w
                    break
                end
            end
        end
    end
    return math.clamp(w / math.max(spd, 0.45) * 0.58, 0, 0.42)
end
function Cbt.bossCanReach(model, row)
    local hrp = getHRP()
    local bhrp = model and (model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart)
    if not (hrp and bhrp) then
        return false
    end
    local dist = (hrp.Position - bhrp.Position).Magnitude
    local reach = tonumber(row and row.DefaultRange) or 20
    local bs = row and row.BasicString
    if type(bs) == "table" then
        reach = math.max(reach, tonumber(bs.HitboxRange) or 0)
    end
    if dist > reach + 12 then
        return false
    end
    if dist <= 14 then
        return true
    end
    local look = Vector3.new(bhrp.CFrame.LookVector.X, 0, bhrp.CFrame.LookVector.Z)
    local to = Vector3.new(hrp.Position.X - bhrp.Position.X, 0, hrp.Position.Z - bhrp.Position.Z)
    if look.Magnitude < 0.05 or to.Magnitude < 0.05 then
        return true
    end
    return look.Unit:Dot(to.Unit) > 0.02
end
function Cbt.fireParry()
    if not hubAlive or not (meleeEnabled or skillAuraOn) then
        return
    end
    if LocalPlayer:GetAttribute("Dead") then
        return
    end
    if LocalPlayer:GetAttribute("Parry_Cooldown_Active") or LocalPlayer:GetAttribute("NoParrying") then
        return
    end
    local now = os.clock()
    if Cbt._parryAt > 0 and (now - Cbt._parryAt) < 0.22 then
        return
    end
    Cbt._parryAt = now
    TheKing.Guard(function()
        TheKing.Fire(ParryRE)
    end, "拼刀")
end
function Cbt.scheduleParry(delay)
    delay = tonumber(delay) or 0
    if delay <= 0 then
        Cbt.fireParry()
        return
    end
    local token = (Cbt._parryTok or 0) + 1
    Cbt._parryTok = token
    task.delay(delay, function()
        if hubAlive and Cbt._parryTok == token then
            Cbt.fireParry()
        end
    end)
end
function Cbt.unhookBossParry()
    local bag = Cbt._parryConns
    if type(bag) == "table" then
        for _, c in ipairs(bag) do
            pcall(function()
                c:Disconnect()
            end)
        end
    end
    Cbt._parryConns = {}
    Cbt._parryHooked = {}
    TheKing.UnbindStepped("dr_boss_parry")
end
function Cbt.hookBossParry(model)
    if not (model and model.Parent) then
        return
    end
    local hooked = Cbt._parryHooked
    if type(hooked) ~= "table" then
        hooked = {}
        Cbt._parryHooked = hooked
    end
    if hooked[model] then
        return
    end
    hooked[model] = true
    local bag = Cbt._parryConns
    if type(bag) ~= "table" then
        bag = {}
        Cbt._parryConns = bag
    end
    local function onAnim(track)
        pcall(function()
            if not hubAlive or not (meleeEnabled or skillAuraOn) then
                return
            end
            if not Cbt.isBossModel(model) then
                return
            end
            local an = track.Animation
            local anName = an and an.Name or ""
            if not Cbt.parryWantAnim(anName) then
                return
            end
            local row = Cbt.bossRow(model)
            if not Cbt.bossCanReach(model, row) then
                return
            end
            Cbt.scheduleParry(Cbt.parryDelay(row, anName))
            -- marker/Keyframe 只补一次火 (同一招 5 通道全发 = 频繁无意义格挡)
            local fired = false
            local function hitNow()
                if fired then
                    return
                end
                fired = true
                Cbt._parryTok = (Cbt._parryTok or 0) + 1
                Cbt.fireParry()
            end
            pcall(function()
                bag[#bag + 1] = track:GetMarkerReachedSignal("Hit"):Connect(hitNow)
            end)
            pcall(function()
                bag[#bag + 1] = track:GetMarkerReachedSignal("Swing"):Connect(hitNow)
            end)
            pcall(function()
                bag[#bag + 1] = track:GetMarkerReachedSignal("Attack"):Connect(hitNow)
            end)
            pcall(function()
                bag[#bag + 1] = track:GetMarkerReachedSignal("Impact"):Connect(hitNow)
            end)
            pcall(function()
                bag[#bag + 1] = track.KeyframeReached:Connect(function(kf)
                    if fired or type(kf) ~= "string" then
                        return
                    end
                    local l = string.lower(kf)
                    if string.find(l, "hit", 1, true) or string.find(l, "swing", 1, true) or string.find(l, "atk", 1, true) then
                        hitNow()
                    end
                end)
            end)
        end)
    end
    local anim = model:FindFirstChildWhichIsA("Animator", true)
    if anim then
        bag[#bag + 1] = anim.AnimationPlayed:Connect(onAnim)
        TheKing.AddConnection(bag[#bag])
        pcall(function()
            for _, tr in ipairs(anim:GetPlayingAnimationTracks()) do
                onAnim(tr)
            end
        end)
    end
    local function onPart(ch)
        if ch and (ch.Name == "Hitbox" or ch.Name == "Hurtbox") then
            local row = Cbt.bossRow(model)
            if Cbt.bossCanReach(model, row) then
                -- 同招多 Hitbox / Hitbox+动画双通道只拼一次: 距上次实际发刀 <0.9s 跳过
                local nowC = os.clock()
                if (nowC - (Cbt._parryAt or 0)) < 0.9 then
                    return
                end
                Cbt._parryTok = (Cbt._parryTok or 0) + 1
                Cbt.fireParry()
            end
        end
    end
    bag[#bag + 1] = model.DescendantAdded:Connect(onPart)
    TheKing.AddConnection(bag[#bag])
end
function Cbt.syncBossParry()
    if not hubAlive or not (meleeEnabled or skillAuraOn) then
        Cbt.unhookBossParry()
        return
    end
    Cbt.bossIndex()
    TheKing.BindStepped("dr_boss_parry", "heartbeat", function()
        if not hubAlive or not (meleeEnabled or skillAuraOn) then
            return
        end
        local now = os.clock()
        if Cbt._parryScanAt > 0 and (now - Cbt._parryScanAt) < 0.22 then
            return
        end
        Cbt._parryScanAt = now
        local my = getHRP()
        for _, en in ipairs(getEnemies()) do
            if en.model and en.hrp and Cbt.isBossModel(en.model) then
                if my and (en.hrp.Position - my.Position).Magnitude < 80 then
                    Cbt.hookBossParry(en.model)
                end
            end
        end
    end)
end

function Cbt.dashRemote()
    local r = Cbt._dashRE
    if r and r.Parent then
        return r
    end
    r = Inputs and Inputs:FindFirstChild("Dash")
    Cbt._dashRE = r
    return r
end

function Cbt.aoeEmitterOn(part)
    if not (part and part.Parent) then
        return false
    end
    -- 粒子挂在 Attachment 下, 不是 AoE_Telegraph 的直接子级
    for _, ch in ipairs(part:GetDescendants()) do
        if ch:IsA("ParticleEmitter") and ch.Enabled then
            return true
        end
    end
    return false
end

function Cbt.aoeRadius(part)
    local r = tonumber(part:GetAttribute("TelegraphRadius"))
    if not (r and r > 3) then
        local par = part.Parent
        r = par and tonumber(par:GetAttribute("TelegraphRadius"))
    end
    if not (r and r > 3) then
        local mdl = part:FindFirstAncestorOfClass("Model")
        local hops = 0
        while mdl and hops < 5 do
            r = tonumber(mdl:GetAttribute("TelegraphRadius"))
            if r and r > 3 then
                break
            end
            local up = mdl.Parent
            mdl = up and up:FindFirstAncestorOfClass("Model")
            hops = hops + 1
        end
    end
    if not (r and r > 3) then
        local best = 0
        for _, ch in ipairs(part:GetDescendants()) do
            if ch:IsA("ParticleEmitter") then
                local sz = ch.Size
                local v = 0
                if typeof(sz) == "NumberSequence" then
                    local kp = sz.Keypoints
                    if type(kp) == "table" and #kp > 0 then
                        v = kp[1].Value
                        local last = kp[#kp].Value
                        if last > v then
                            v = last
                        end
                    end
                elseif type(sz) == "number" then
                    v = sz
                end
                if v > best then
                    best = v
                end
            end
        end
        if best > 8 then
            r = best * 1.35
        else
            r = 22
        end
    end
    return r + 3
end

-- 小怪 MeteorZones: 不挂 NPC.Telegraph_Root, 走 SpellBurst {EffectName=Grenade, Lifetime=3, Position}
function Cbt.hookSpellBurst()
    if Cbt._burstHooked then
        return
    end
    Cbt._burstHooked = true
    Cbt._burstZones = Cbt._burstZones or {}
    local folder = ReplicatedStorage:FindFirstChild("Player")
    folder = folder and folder:FindFirstChild("Remotes")
    local rem = folder and folder:FindFirstChild("SpellBurst")
    if not (rem and rem.OnClientEvent) then
        return
    end
    TheKing.AddConnection(rem.OnClientEvent:Connect(function(payload)
        if type(payload) ~= "table" then
            return
        end
        if tostring(payload.EffectName or "") ~= "Grenade" then
            return
        end
        local pos = payload.Position
        if typeof(pos) ~= "Vector3" then
            return
        end
        local life = tonumber(payload.Lifetime) or 3
        local z = Cbt._burstZones
        z[#z + 1] = {
            p = pos,
            r = tonumber(Cbt.BurstRad) or 16,
            exp = os.clock() + math.max(1.2, life * 0.9),
        }
        if #z > 28 then
            table.remove(z, 1)
        end
    end))
end

function Cbt.bestBurstCenter(pos, now)
    local z = Cbt._burstZones
    if not z then
        return nil, -1
    end
    local bestP, bestNeed = nil, -1
    for i = #z, 1, -1 do
        local b = z[i]
        if now > (b.exp or 0) then
            table.remove(z, i)
        else
            local dx = pos.X - b.p.X
            local dz = pos.Z - b.p.Z
            local dist = math.sqrt(dx * dx + dz * dz)
            local rad = tonumber(b.r) or 16
            if dist < rad then
                local need = rad - dist
                if need > bestNeed then
                    bestNeed = need
                    bestP = b.p
                end
            end
        end
    end
    return bestP, bestNeed
end

function Cbt.collectAoeParts(into)
    local function take(part)
        if part and part:IsA("BasePart") then
            into[#into + 1] = part
        end
    end
    for _, en in ipairs(getEnemies()) do
        local mdl = en.model
        if mdl then
            local root = mdl:FindFirstChild("Telegraph_Root")
            take((root and root:FindFirstChild("AoE_Telegraph")) or mdl:FindFirstChild("AoE_Telegraph", true))
        end
    end
    local map = getMapDir()
    local npcs = map and map:FindFirstChild("NPCs")
    if npcs then
        for _, mdl in ipairs(npcs:GetChildren()) do
            local root = mdl:FindFirstChild("Telegraph_Root")
            if root then
                take(root:FindFirstChild("AoE_Telegraph"))
            end
        end
    end
    local folder = workspace:FindFirstChild("SpellTelegraphs")
    if folder then
        for _, d in ipairs(folder:GetDescendants()) do
            if d.Name == "AoE_Telegraph" and d:IsA("BasePart") then
                take(d)
            end
        end
    end
end

function Cbt.tickAoeDodge()
    if not hubAlive or not Cbt.aoeDodgeOn or not (meleeEnabled or skillAuraOn) then
        return
    end
    if LocalPlayer:GetAttribute("Dead") or LocalPlayer:GetAttribute("NoDodging") then
        return
    end
    local hrp = getHRP()
    local hum = getHum()
    if not (hrp and hum) or hum.Health <= 0 then
        return
    end
    local now = os.clock()
    local pos = hrp.Position
    local parts = {}
    Cbt.collectAoeParts(parts)
    local bestC, bestNeed = nil, -1
    for i = 1, #parts do
        local part = parts[i]
        if Cbt.aoeEmitterOn(part) then
            local c = part.Position
            local dx = pos.X - c.X
            local dz = pos.Z - c.Z
            local dist = math.sqrt(dx * dx + dz * dz)
            local rad = Cbt.aoeRadius(part)
            if dist < rad then
                local need = rad - dist
                if need > bestNeed then
                    bestNeed = need
                    bestC = c
                end
            end
        end
    end
    local burstC, burstNeed = Cbt.bestBurstCenter(pos, now)
    if burstC and burstNeed > bestNeed then
        bestC = burstC
        bestNeed = burstNeed
    end
    if not bestC then
        return
    end
    Cbt._aoeUntil = now + 0.4
    if LocalPlayer:GetAttribute("Dodge_Cooldown_Active") then
        return
    end
    if Cbt._dodgeFireAt and (now - Cbt._dodgeFireAt) < 0.45 then
        return
    end
    local dir = Vector3.new(pos.X - bestC.X, 0, pos.Z - bestC.Z)
    if dir.Magnitude < 1.2 then
        local look = hrp.CFrame.LookVector
        dir = Vector3.new(-look.X, 0, -look.Z)
    end
    if dir.Magnitude < 0.05 then
        dir = Vector3.new(0, 0, 1)
    else
        dir = dir.Unit
    end
    local re = Cbt.dashRemote()
    if not re then
        return
    end
    Cbt._dodgeFireAt = now
    TheKing.Guard(function()
        TheKing.Fire(re, dir)
    end, "闪避地板")
end

function Cbt.syncAoeDodge()
    Cbt.hookSpellBurst()
    if hubAlive and Cbt.aoeDodgeOn and (meleeEnabled or skillAuraOn) then
        TheKing.BindStepped("dr_aoe_dodge", "heartbeat", Cbt.tickAoeDodge)
    else
        TheKing.UnbindStepped("dr_aoe_dodge")
    end
end
Cbt.hookSpellBurst()

TheKing.BindToggle(BattleTab, {
    Title = "杀戮光环 (自动平A)",
    Flag = "dr_melee_aura",
    Interval = 0.1,
    OnEnable = function()
        meleeEnabled = true
        Cbt.syncBossParry()
        Cbt.syncKite()
        Cbt.syncAoeDodge()
        Cbt.lockFace()
        return true
    end,
    OnDisable = function()
        meleeEnabled = false
        autoRotateLockUntil = 0
        if not skillAuraOn then
            Cbt.lock = nil
        end
        Cbt.syncBossParry()
        Cbt.syncKite()
        Cbt.syncAoeDodge()
        Cbt.lockFace()
        local hum = getHum()
        if hum then
            pcall(function()
                hum.AutoRotate = true
            end)
        end
    end,
    OnTick = function()
        Cbt.tickAoeDodge()
        local now = os.clock()
        -- 长按连击: 间隔跟 Cbt.atkInterval (职业×装备), 与 fireMeleeOnce 同源
        -- 朝向由 lockFace 锁目标; 发包方向是指向锁定, 不跟 WASD
        if now - meleeLastAttack >= Cbt.atkInterval() then
            fireMeleeOnce()
        end
        -- 近战双光环: 半半径外就朝最近怪贴脸 (0.3s 一发 MoveTo)
        -- 手动 WASD 优先于 MoveTo; 远程职业有 kite 站位不走这
        -- 聚怪旋转窗口内高频 tick (autoApproach 内部自带 0.12s 节流), 不等 0.3s
        local twisting = now < (Cbt.twistUntil or 0)
        if meleeEnabled and skillAuraOn and not Cbt.isRanged() and not Cbt.kiting
            and (twisting or now - autoApproachAt >= 0.3) then
            autoApproachAt = now
            Cbt.autoApproach()
        end
    end,
})

TheKing.BindToggle(BattleTab, {
    Title = "谨慎避战",
    Flag = "dr_aoe_dodge",
    Interval = 0.05,
    Value = false,
    Notify = false,
    OnEnable = function()
        Cbt.aoeDodgeOn = true
        Cbt.syncAoeDodge()
        return true
    end,
    OnDisable = function()
        Cbt.aoeDodgeOn = false
        Cbt.syncAoeDodge()
    end,
    OnTick = function()
        Cbt.tickAoeDodge()
    end,
})

-- ---- 杀戮技能光环: 开关在职业选择之上 ----
-- 默认职业: 当前游戏职业 > 上次菜单
local classIdx = 1
do
    local curCls = LocalPlayer:GetAttribute("Current_Class") or LocalPlayer:GetAttribute("Active_Class")
    local matched = false
    if type(curCls) == "string" and curCls ~= "" then
        for i, cp in ipairs(CLASS_PROFILES) do
            if cp.Folder == curCls then
                classIdx = i
                matched = true
                break
            end
        end
    end
    if not matched then
        local saved = PREF.classLabel
        if type(saved) == "string" and saved ~= "" then
            for i, cp in ipairs(CLASS_PROFILES) do
                if cp.Label == saved or cp.Folder == saved or cp.Name == saved
                    or (cp.Folder and string.find(saved, cp.Folder, 1, true))
                    or (cp.Name and string.find(saved, cp.Name, 1, true)) then
                    classIdx = i
                    break
                end
            end
        end
    end
end
function Cbt.syncClass()
    local cur = LocalPlayer:GetAttribute("Current_Class") or LocalPlayer:GetAttribute("Active_Class")
    if type(cur) ~= "string" or cur == "" then
        return
    end
    local now = CLASS_PROFILES[classIdx]
    if now and now.Folder == cur then
        return
    end
    -- 载入界面注入: Classes/Class_Data 流式未就绪时档案全废 — 游戏数据到位后重建档案再匹配
    if #CLASS_PROFILES == 0 or not ReplicatedStorage:FindFirstChild("Classes") then
        local okRe = pcall(function()
            local idx = buildClassNameIndex()
            CLASS_PROFILES = normalizeArchive(CLASS_ARCHIVE_RAW, idx)
            table.clear(CLASS_BY_FOLDER)
            for _, cp in ipairs(CLASS_PROFILES) do
                CLASS_BY_FOLDER[cp.Folder] = cp
            end
        end)
        if okRe and #CLASS_PROFILES > 0 then
            print("[RCWTK] 职业档案已重建 (" .. tostring(#CLASS_PROFILES) .. " 个) — 载入期注入数据晚到")
            local drop0 = Cbt.classDrop
            if drop0 then
                pcall(function()
                    local labels = {}
                    for _, cp in ipairs(CLASS_PROFILES) do
                        labels[#labels + 1] = cp.Label
                    end
                    if drop0.Refresh then
                        drop0:Refresh(labels)
                    end
                end)
            end
        end
        if #CLASS_PROFILES == 0 then
            return
        end
    end
    for i, cp in ipairs(CLASS_PROFILES) do
        if cp.Folder == cur then
            classIdx = i
            _skillCache.folder = nil
            _skillCache.data = nil
            _meleeRangeCache.t = 0
            prefSet("classLabel", cp.Label)
            local drop = Cbt.classDrop
            if drop then
                pcall(function()
                    if drop.SetValue then
                        drop:SetValue(cp.Label)
                    elseif drop.Set then
                        drop:Set(cp.Label)
                    end
                end)
            end
            return
        end
    end
end
do
    TheKing.AddConnection(LocalPlayer:GetAttributeChangedSignal("Current_Class"):Connect(function()
        Cbt.syncClass()
    end))
    -- 注入早于数据加载: DataLoaded 翻 true 时补跑一次 (否则首注入 Current_Class=nil, 下拉永远 none)
    if LocalPlayer:GetAttribute("DataLoaded") ~= true then
        TheKing.AddConnection(LocalPlayer:GetAttributeChangedSignal("DataLoaded"):Connect(function()
            if LocalPlayer:GetAttribute("DataLoaded") == true then
                Cbt.syncClass()
            end
        end))
    end
end

local classLabels = {}
for _, cp in ipairs(CLASS_PROFILES) do
    classLabels[#classLabels + 1] = cp.Label
end

local skillAuraLastSlot = nil
local lastSkillCast = {}
local skillsData = nil
-- fireQueuedSkill 使用前向声明的 skillPending/skillCursor/skillAuraOn (592 区声明, 此处勿重复 local)
local function fireQueuedSkill(pd, now)
    local hrp = getHRP()
    if not hrp then
        return
    end
    local tg = pd.target
    if tg and tg.hrp and tg.hrp.Parent then
        Cbt.mark(tg)
        faceTowards(hrp, tg.hrp.Position)
    end
    local cp = CLASS_PROFILES[classIdx]
    local skills = cp and cachedClassSkills(cp.Folder)
    -- 双形态: 发包前同步一次形态, 视图按当前形态取伤害/距离
    -- (DualForm local 声明在本区块之后 — 词法捕获不到, 必须走 Cbt.dualFormState 运行时解析, 见 v1.14.1 教训)
    if cp and cp.DualForm and pd.slot ~= "E" then
        skills = Cbt.dualSkillView(skills, Cbt.dualFormState().spear)
    end
    local data = skills and skills[pd.slot]
    if pd.slot == "E" then
        -- 终极 (G键/槽位"E"): HasUltimate+UltimateReady 已在 findReadySkill 验过
        TheKing.Fire(SkillRE, "E", "tap", Vector3.new(0, 0, 0))
    else
        TheKing.Fire(SkillRE, pd.slot, "tap", Vector3.new(0, 0, 0))
    end
    -- 双形态按 形态+槽位 分键计时 (1S/1P/...), 4 技能双形态共用一 CD 记原键
    lastSkillCast[Cbt.dualCastKey(pd.slot)] = now
    lastSkillCast[pd.slot] = now
    skillAuraLastSlot = pd.slot
    if pd.slot == 3 or pd.slot == 4 then
        _meleeRangeCache.t = 0
    end
    -- 冲刺技不能冻移速 (WalkSpeed=0 会把突进掐死); 只有升空类才短冻
    skillFreezeMove = (tonumber(data and data.LiftSpeed) or 0) > 0
    -- 聚怪技施放 (档案 PullSlot): 丢完启动旋转拖怪 — 绕奇点圆周走位把周围怪吸成一堆
    -- (无限核心 Blue: 施放可拖动, 用户实测; 其他职业无 PullSlot 字段自动跳过)
    if cp and tonumber(cp.PullSlot) and pd.slot == cp.PullSlot and tg and tg.hrp and tg.hrp.Parent then
        Cbt.twistUntil = now + (tonumber(cp.TwistAfterPull) or 1.5)
        Cbt.twistCenter = tg.hrp
        Cbt.twistAng = math.atan2(hrp.Position.Z - tg.hrp.Position.Z, hrp.Position.X - tg.hrp.Position.X)
    end
    -- 技能出手窗口 0.22s: 期间平A让路 (skillHoldUntil) 且光环 tick 不再插包 (busy),
    -- 防止平A包挤掉技能动画被服务端吞 → 技能 CD 转了却没放出来
    -- 双形态 4 (切形态): swapLen 只是静默窗上限 — 实际切换动画+形态消抖实测 <1s 就翻,
    -- 固定锁 1.5s = 翻转后白罚站 ~0.5s (发呆真空, v1.16.3); 登记 swapWatch, 翻转确认即提前解锁
    local holdLen = 0.22
    if cp and cp.DualForm and pd.slot == 4 then
        holdLen = tonumber(Cbt.DualSwapLen) or 1.5
        Cbt.swapWatch = { at = now }
        Cbt.swapFailAt = nil -- v1.16.6: 新 fire4 重置上次吞包失败标记
        if _G.DR_DEADLOG == true then
            -- v1.16.5-dbg: fire4 精确时间线 (频率/是否被吞/形态) — 定位 fire4 风暴
            -- (fireQueuedSkill 定义在 DualForm local 之前, 词法捕获不到 → 一律走 dualFormState)
            local st4 = Cbt.dualFormState()
            warn(string.format("[FIRE4] @%.2f form=%s rem4=%s lastFormGap=%.2f", now,
                tostring(st4.spear and "SPEAR" or "SWORD"),
                tostring(tonumber(LocalPlayer:GetAttribute("Skill4_CooldownRemaining")) or -9),
                now - (st4.lastForm or 0)))
        end
    end
    skillHoldUntil = now + holdLen
    skillDumpSlot = nil
    skillBusyUntil = now + holdLen
    skillRestUntil = 0
    -- 死寂审计时间戳 (v1.16.5-dbg): 最近一次真正出手 (技能/平A), [DEAD] 快照用
    Cbt.lastFireAt = now
    Cbt.lastFireSlot = pd.slot
end

-- ==================== 双形态职业 (倒置长矛 Unrestricted): 形态识别 + 双套 CD 视图 ====================
-- SpecialMoveset 0=剑 1=矛 (服务器权威, 但无 Player 属性可读); 1/2/3 Sword/Spear 双套独立 CD
-- 形态识别走武器模型 Transparency (锻造霸主 Bow 同款已验证): Sword 可见=剑态, Spear 可见=矛态
local DualForm = { on = false, spear = false, lastCheck = 0, lastForm = nil }
-- 双形态交替猛攻参数 (v1.15.0): swapLen = 4 切换动画前摇 (Tool Swap ~1.5s), busy/预判共用;
-- swapGate = 形态翻转后最小再切间隔 (防动画尾端消抖未稳时乱切; 4 CD 5s 是主节流, 此门兜底)
Cbt.DualSwapLen = 1.5
Cbt.DualSwapGate = 1.2
-- 剑2(3s)/剑3(2.2s)/矛3(3.6s) 站桩期间服务端常锁 Tool Swap, 这时 fire4 会被吞
function Cbt.dualSwapBlocked(now)
    if DualForm.spear then
        local t3 = lastSkillCast["3P"]
        return t3 ~= nil and (now - t3) < 3.6
    end
    local t2 = lastSkillCast["2S"]
    local t3 = lastSkillCast["3S"]
    if t2 and (now - t2) < 3.0 then
        return true
    end
    return t3 ~= nil and (now - t3) < 2.2
end
function Cbt.dualFormState()
    local cp = CLASS_PROFILES[classIdx]
    if not (cp and cp.DualForm) then
        DualForm.on = false
        return DualForm
    end
    DualForm.on = true
    local now = os.clock()
    -- 0.15s 缓存; 发 4 后 2s 强制重查窗 (Tool Swap 动画 1.5s, 中途 Transparency 未翻, 别在过渡期读)
    local force = (now - (lastSkillCast[4] or 0)) < 2.0
    if not force and (now - DualForm.lastCheck) < 0.15 then
        return DualForm
    end
    DualForm.lastCheck = now
    local pm = workspace:FindFirstChild("PlayerModels")
    local mine = pm and pm:FindFirstChild(LocalPlayer.Name)
    local holder = mine and mine:FindFirstChild("HumanoidRootPart")
    holder = holder and holder:FindFirstChild("Holder")
    local ra = holder and holder:FindFirstChild("Right_Arm")
    if not ra then
        return DualForm
    end
    local sw = ra:FindFirstChild("Sword")
    local sp = ra:FindFirstChild("Spear")
    local spear
    if sw and sp then
        local swT = sw.Transparency
        local spT = sp.Transparency
        if math.abs(swT - spT) > 0.1 then
            spear = spT < swT
        else
            -- 两把同透明度 (切换动画过渡/都藏): 维持上次形态, 抖动期不翻转
            spear = DualForm.spear
        end
    elseif sw then
        spear = false
    elseif sp then
        spear = true
    else
        spear = DualForm.spear
    end
    -- v1.21.0 双源校验: 服务器权威 M1Mode (Char:GetAttribute) 优先级 > Transparency.
    -- Transparency 在切换动画瞬时高频抖动; M1Mode 是服务端同步无抖动.
    local m1 = LocalPlayer.Character and LocalPlayer.Character:GetAttribute("M1Mode")
    if m1 == "Spear" then
        spear = true
    elseif m1 == "Sword" then
        spear = false
    end
    if spear ~= DualForm.spear then
        -- 消抖: 切换动画期间 Transparency 过渡会高频抖动, 连续 0.25s 一致才翻转
        -- (翻转一次 = 1/2/3 计时分键全换 + 视图换套, 抖动会打光输出循环)
        if DualForm.pendingSpear == spear and (now - (DualForm.pendingAt or 0)) >= 0.25 then
            DualForm.spear = spear
            DualForm.lastForm = now
            DualForm.pendingSpear = nil
        elseif DualForm.pendingSpear ~= spear then
            DualForm.pendingSpear = spear
            DualForm.pendingAt = now
        end
    else
        DualForm.pendingSpear = nil
    end
    return DualForm
end

-- 双形态 CD 视图: 视图把 skills[slot] 替换成当前形态分支, lastSkillCast 按形态分键 (1S/1P/2S...)
-- 挂 Cbt (运行时解析): fireQueuedSkill 定义在本区块之前, local 词法捕获不到
function Cbt.dualSkillView(skills, spear)
    local view = {}
    for i = 1, 4 do
        local d = skills[i]
        if d and d.Sword and d.Spear then
            view[i] = spear and d.Spear or d.Sword
        else
            view[i] = d
        end
    end
    return view
end
local function formKey(slot, spear)
    return slot .. (spear and "P" or "S")
end
-- 挂 Cbt: fireQueuedSkill 定义在本区块之前, local 词法捕获不到 → 表方法运行时解析
-- 4 槽 (换武器) 返回原键: CD 5s 双形态共用, 按 4S/4P 分键会让切换 CD 判定失效 (v1.14.1 修复)
function Cbt.dualCastKey(slot)
    if not DualForm.on or slot == "E" or slot == 4 then
        return slot
    end
    return formKey(slot, DualForm.spear)
end

local function skillSlotReady(slot, data, now)
    local c = tonumber(LocalPlayer:GetAttribute("Skill" .. slot .. "_Charges"))
    if c ~= nil and c <= 0 then
        return false
    end
    local since = now - (lastSkillCast[Cbt.dualCastKey(slot)] or 0)
    local onCd = LocalPlayer:GetAttribute("Skill" .. slot .. "_OnCooldown")
    if DualForm.on and data then
        -- 双口径就绪 (v1.16.4): 服务端 Rem≤0 就绪, 或本地分键计时已到 cd 就绪。
        -- 为何加本地口径: 塔内 Boss 战服务端繁忙时 Rem 属性冻结/滞后 (钾实测同值 >4s 不递减,
        -- OnCooldown 同步滞后), 旧代码 100% 信 Rem+onCd → 技能真实 CD 好却被旧值卡死,
        -- 憋手只平A = 周期性"发呆一下"; Rem 解冻跳 0 又突然连放。
        -- 本地 since≥cd 即放: 服务端真没到点最多每 CD 一空包 (拒收无害, lastCast 同步刷新)。
        -- v1.16.2 吞包兜底保留: 吞包时 Rem 保持 0 → 第一分支就绪 → 0.5s 快重试。
        -- 例外 (v1.16.5): slot4 (换武器) 不做本地兜底, 严格服务端 Rem≤0 权威。
        --   4 的 CD 是双形态切换主节流 (服务端强控, 含动画/网络余量, 档案 5s 与真实不符);
        --   本地 since≥5 提前 fire4 → 服务端拒收 (切换中) → 吞包 → 0.5s 重试 = fire4 风暴,
        --   切换动画每次被下一发 fire4 重置 → 角色"发呆+摆切换动作"循环 (钾实测 rem4=4.4 仍 fire4)。
        --
        -- ★★★ v1.21.0 动态 CD 改造 ★★★
        -- 服务端 SkillN_CooldownDuration 不持续广播 (只在进入冷却那帧下发); 改读 Stat_CooldownReduction
        -- 实时算 base × (1 - CDR) 兜底. CDR 多源汇总 (Stat_/RunBuff_/AchBoost_/Perk_/Passive_).
        local rem = tonumber(LocalPlayer:GetAttribute("Skill" .. slot .. "_CooldownRemaining"))
        local cd = tonumber(LocalPlayer:GetAttribute("Skill" .. slot .. "_CooldownDuration"))
        if not cd or cd <= 0 then
            -- 服务端没下发时, 用 base × (1 - CDR/100) 算实时 CD
            local base = tonumber(data.Cd or data.Cooldown)
            local cdr = tonumber(LocalPlayer:GetAttribute("Stat_CooldownReduction"))
                + tonumber(LocalPlayer:GetAttribute("RunBuff_CooldownReduction") or 0)
                + tonumber(LocalPlayer:GetAttribute("AchBoost_CooldownReduction") or 0)
                + tonumber(LocalPlayer:GetAttribute("Perk_CooldownReduction") or 0)
                + tonumber(LocalPlayer:GetAttribute("Passive_CooldownReduction") or 0)
            if base then
                cd = base * (1 - (cdr or 0) / 100)
            else
                cd = base  -- 完全没 CDR 数据时退化
            end
        end
        if slot == 4 then
            -- 冷却好时服务端不发 Rem (nil); 冷却中才有数字。nil 或 ≤0 才算就绪 (v1.20.0)
            return rem == nil or rem <= 0
        end
        -- 同槽 0.85s 防 Rem 滞后连刷; 之后若 Rem 仍为 0 但本地还没到档案 CD, 当滞后不当就绪
        -- (v1.20.0 见 0 就放 → 刚放完仍算「有技能」去切对面 / 或把同槽再丢一遍)
        if since < 0.85 then
            return false
        end
        if rem ~= nil and rem > 0 then
            return cd ~= nil and since >= cd
        end
        -- 0.75 阈值保留: 让本地兜底略晚于服务端真 CD, 防本地 since 偏差抢放
        if cd and since < cd * 0.75 then
            return false
        end
        return true
    end
    -- 非双形态: 有剩余充能就继续丢, 不等 OnCooldown; 没充能字段时才看 CD
    if onCd == true and not (c ~= nil and c > 0) then
        return false
    end
    -- 0.05s 防抖 (旧 0.12): CD 一好下一 tick 就发, 技能不憋手
    return since >= 0.05
end

local function skillSlotTarget(data, pos)
    local range = Cbt.skillFireRange(data)
    local best, bd = nil, range
    for _, en in ipairs(getEnemies()) do
        if Cbt.alive(en) then
            local d = (en.hrp.Position - pos).Magnitude
            if d <= range and d < bd then
                bd = d
                best = en
            end
        end
    end
    return best
end

-- 活怪计数 (UltMinMobs 门用): 半径内 Health>0 的怪
local function countAliveMobs(radius, pos)
    local n = 0
    for _, en in ipairs(getEnemies()) do
        if Cbt.alive(en) and not en.model:GetAttribute("IsDormant") then
            local h = en.hrp.Parent and en.hrp.Parent:FindFirstChildOfClass("Humanoid")
            if h and h.Health > 0 and (en.hrp.Position - pos).Magnitude <= radius then
                n = n + 1
            end
        end
    end
    return n
end

-- 当前套 1/2/3 就绪技能数 (视图数据 + skillSlotReady 服务端权威)
-- 只做"该放还是该切"的决策权重; target 距离不足由 trySlot 兜底 (宁高估不憋手)
local function curFormReadiness(skills, now)
    local n = 0
    for slot = 1, 3 do
        if skillSlotReady(slot, skills[slot], now) then
            n = n + 1
        end
    end
    return n
end

-- 目标形态 1/2/3 就绪统计 (双套独立侦测, v1.16.0): 本地分键计时 + 前摇预判
-- 服务端只下发"当前形态"的 Remaining, 另一套无属性可读 → 目标套就绪只能本地估
-- 返回: altN=切过去立即能放数, altSoon=距就绪 ≤ 切换动画(swapLen) 数
--   (cd 用档案 base 值, CDR buff 会让实际更早好 → soon 判定偏保守, 配合前摇正好覆盖)
local function altFormReadiness(rs, tSpear, now, swapLen)
    local altN, altSoon = 0, 0
    for slot = 1, 3 do
        local d = rs[slot]
        if d and d.Sword and d.Spear then
            -- v1.21.0 动态 CD: 服务端 CooldownDuration 不持续广播, 用 base × (1 - CDR/100) 算
            local cd = tonumber(LocalPlayer:GetAttribute("Skill" .. slot .. "_CooldownDuration"))
            if not cd or cd <= 0 then
                local base = tonumber((tSpear and d.Spear or d.Sword).Cd) or 8
                local cdr = tonumber(LocalPlayer:GetAttribute("Stat_CooldownReduction"))
                    + tonumber(LocalPlayer:GetAttribute("RunBuff_CooldownReduction") or 0)
                    + tonumber(LocalPlayer:GetAttribute("AchBoost_CooldownReduction") or 0)
                    + tonumber(LocalPlayer:GetAttribute("Perk_CooldownReduction") or 0)
                    + tonumber(LocalPlayer:GetAttribute("Passive_CooldownReduction") or 0)
                cd = base * (1 - (cdr or 0) / 100)
            end
            local cast = lastSkillCast[formKey(slot, tSpear)]
            if not cast or (now - cast) >= cd then
                altN = altN + 1
            elseif (now - cast) >= cd - swapLen then
                altSoon = altSoon + 1
            end
        end
    end
    return altN, altSoon
end

-- 冷却好了就丢: 1→4 优先, 有充能打光, 不留手
findReadySkill = function(now)
    local cp = CLASS_PROFILES[classIdx]
    local skills = cp and cachedClassSkills(cp.Folder)
    skillsData = skills
    if not skills then
        return nil
    end
    local hrp = getHRP()
    if not hrp then
        return nil
    end
    local pos = hrp.Position
    -- 双形态: 同步形态 + 按当前形态取视图 (技能4 是普通表原样透传)
    -- rawSkills 保留原始 Sword/Spear 双分支表: 切形态预判要读"目标形态"技能, 视图只有当前形态单分支
    local rawSkills = nil
    if cp and cp.DualForm then
        rawSkills = skills
        skills = Cbt.dualSkillView(skills, Cbt.dualFormState().spear)
        skillsData = skills
    end
    -- 终极槽 ("E", G键) 优先: 充能接近满就发 (不等满格/Ready 信号), 防抖 3s 保证能量一到立刻出
    -- 永不终极 (neverUlt): 开关开着 → E 槽整体跳过, 有终极的职业也不放
    -- UltMinMobs 门 (无限核心类零伤害控场终极): 活怪 <门值 且锁的不是 BOSS → 捏着不放
    -- (100 格全冻 15s 站桩长前摇, 残局单体空放 = 15s 白打窗口 + 纯亏前摇, 留着下一波怪海开)
    local ultMax = tonumber(LocalPlayer:GetAttribute("UltimateChargeMax")) or 100
    local ultFull = (tonumber(LocalPlayer:GetAttribute("UltimateCharge")) or 0) >= ultMax * 0.85
    if LocalPlayer:GetAttribute("HasUltimate") == true and not neverUlt and ultFull and LocalPlayer:GetAttribute("SkillE_OnCooldown") ~= true
        and (now - (lastSkillCast["E"] or 0)) >= 3 then
        local minMobs = tonumber(cp and cp.UltMinMobs) or 0
        local tgtE = nil
        if Cbt.lock and Cbt.alive(Cbt.lock) and (Cbt.lock.hrp.Position - pos).Magnitude <= 40 then
            tgtE = Cbt.lock
        else
            local bd = 40
            for _, en in ipairs(getEnemies()) do
                if Cbt.alive(en) then
                    local d = (en.hrp.Position - pos).Magnitude
                    if d <= bd then
                        bd = d
                        tgtE = en
                    end
                end
            end
        end
        if tgtE then
            local lockIsBoss = Cbt.isBossModel(tgtE.model)
            if minMobs > 0 and not lockIsBoss and countAliveMobs(60, pos) < minMobs then
                tgtE = nil
            end
        end
        if tgtE then
            Cbt.lock = tgtE
            return { slot = "E", target = tgtE }
        end
    end
    local function trySlot(slot)
        local data = skills[slot]
        if not data or not skillSlotReady(slot, data, now) then
            return nil
        end
        -- 双形态换武器(4): 自施法切换, 不该被 target 射程门卡死 — 有活怪即可切 (面向最近)
        -- (实测: 玩家离怪稍远只够长手技能时, 旧射程门让 4 永远 nil → 永不切形态, 单技能空转)
        if DualForm.on and slot == 4 then
            local any = nil
            if Cbt.lock and Cbt.alive(Cbt.lock) then
                any = Cbt.lock
            else
                local bd = 1e9
                for _, en in ipairs(getEnemies()) do
                    if Cbt.alive(en) then
                        local d = (en.hrp.Position - pos).Magnitude
                        if d < bd then
                            bd = d
                            any = en
                        end
                    end
                end
            end
            if any then
                Cbt.lock = any
                return { slot = 4, target = any }
            end
            return nil
        end
        local reach = Cbt.skillFireRange(data)
        if Cbt.lock and Cbt.alive(Cbt.lock) then
            local d = (Cbt.lock.hrp.Position - pos).Magnitude
            if d <= reach then
                return { slot = slot, target = Cbt.lock }
            end
        end
        local best = skillSlotTarget(data, pos)
        if best then
            Cbt.lock = best
            return { slot = slot, target = best }
        end
        return nil
    end
    -- 双形态切换调度: 见下方 v1.16.2 决策序注释
    -- (形态识别走 PlayerModels 武器 Transparency + M1Mode 双源校验; 目标套就绪本地分键计时, 服务端无另一套属性)
    if DualForm.on then
        -- 当前套打光才切 (v1.20.1): 有 1/2/3 就绪绝不容 4 插队 (v1.20.0 的「对面≥2 就切」
        -- 会在当前套还剩技能、或技能刚够不着时换武器 = 有技能却切 + 好了的技能被拖过)。
        --  A) 当前套 ≥1 → 只放 1/2/3; 打不着 return nil 贴脸, 不切
        --  B) 当前套打空且对面 ≥1 (含前摇内将好) → 切 (含 v1.21.0 形态偏好)
        --  C) 全无 → 平A
        local d4 = skills[4]
        local c4ready = d4 and skillSlotReady(4, d4, now)
        local c4retry = (now - (lastSkillCast[4] or 0)) >= 2.8
        local curN = curFormReadiness(skills, now)
        if curN >= 1 then
            for slot = 1, 3 do
                local hit = trySlot(slot)
                if hit then
                    return hit
                end
            end
            return nil
        end
        -- canSwap: 4 就绪 + 2.8s 退避 + DualSwapGate + 站桩期不切
        local canSwap = c4ready and c4retry
            and (now - (DualForm.lastForm or 0)) >= (tonumber(Cbt.DualSwapGate) or 1.2)
            and not Cbt.dualSwapBlocked(now)
        if canSwap then
            local tSpear = not DualForm.spear
            local swapLen = tonumber(Cbt.DualSwapLen) or 1.5
            local altN, altSoon = altFormReadiness(rawSkills or skills, tSpear, now, swapLen)
            -- v1.21.0 形态偏好 (双光环最大化输出):
            -- 矛 2 = 11x 瞬移背 (单体爆发); 剑 2/3 = 站桩多段 AoE (群怪).
            -- 单体 (≤1 怪) 剑→矛且 altN≥2 → 切矛追单体爆发
            -- 群怪 (≥2 怪) 矛→剑且 altN≥2 → 切剑吃 AoE 群杀
            -- 其余走原"对面 ≥1 就切"逻辑
            local mobsNearby = countAliveMobs(40, pos)
            local preferSwap = false
            if not DualForm.spear then  -- 当前剑
                if mobsNearby <= 1 and (altN >= 2 or altN + altSoon >= 2) then
                    preferSwap = true
                end
            else  -- 当前矛
                if mobsNearby >= 2 and (altN >= 2 or altN + altSoon >= 2) then
                    preferSwap = true
                end
            end
            if preferSwap or (altN >= 1 or altN + altSoon >= 1) then
                local hit4 = trySlot(4)
                if hit4 then
                    return hit4
                end
            end
        end
        return nil
    end
    -- 非双形态: 原有 1→4 顺序
    for slot = 1, 4 do
        local hit = trySlot(slot)
        if hit then
            return hit
        end
    end
    return nil
end

-- 双形态 4 切换静默窗动态解锁 (v1.16.3): fire4 登记 swapWatch 后, OnTick 每拍调本方法。
-- 形态翻转确认 (lastForm = 消抖完成的翻转时刻 ≥ fire4) = 切换动画已结束 → 立即清 busy/hold,
-- 下一拍 findReadySkill 就用新套视图连发, 不留 ~0.5s 白罚站。兜底上限 DualSwapLen 防翻转检测失效永锁。
-- (表方法形式: 不占主闭包顶层 local 池, 寄存器峰值 +0)
function Cbt.tickSwapWatch(now)
    local sw = Cbt.swapWatch
    if not sw or sw.done then
        return
    end
    local st = Cbt.dualFormState()
    -- 翻转迹象: pendingSpear 已进入消抖 (武器 Transparency 已开始动) 或已翻 → 切换进行中
    local moving = st.pendingSpear ~= nil or (st.lastForm or 0) >= sw.at
    if st.lastForm and st.lastForm >= sw.at and now - st.lastForm >= 0.05 then
        sw.done = true
        Cbt.swapWatch = nil
        Cbt.swapFailAt = nil
        skillBusyUntil = 0
        skillHoldUntil = 0
        return
    end
    -- v1.16.6 吞包快速识别: fire4 后 0.7s 无任何翻转迹象 = 被服务端吞 (切换没启动)。
    --   原实现等 DualSwapLen(1.5s) 兜底才解锁 → 吞一次白锁 1.5s (发呆); 提前解 + 记失败,
    --   当前套技能/平A 恢复, 重试走 2.8s 退避 (错开服务端切换保护窗, 钾实测手动 fire4 也吞)。
    if not moving and now - sw.at >= 0.7 then
        sw.done = true
        Cbt.swapWatch = nil
        Cbt.swapFailAt = now
        skillBusyUntil = 0
        skillHoldUntil = 0
        return
    end
    if now - sw.at >= (tonumber(Cbt.DualSwapLen) or 1.5) then
        sw.done = true
        Cbt.swapWatch = nil
        Cbt.swapFailAt = nil
        skillBusyUntil = 0
        skillHoldUntil = 0
    end
end

-- 死寂审计 (v1.16.5-dbg, 表方法不占主闭包 local): 有近怪但 >0.7s 无任何出手 → 打内部快照。
-- 开关 _G.DR_DEADLOG=true (外部注入), 定位"发呆"段卡点: busy/hold 锁剩余 + 最近出手 +
-- 各技能服务端 Rem 与本地 since + 形态。定位完随正式修复移除。
function Cbt.auditDead(now)
    local gap = now - (Cbt.lastFireAt or 0)
    if gap < 0.7 then
        Cbt._deadLogAt = nil
        return
    end
    local tgt = (Cbt.lock and Cbt.alive(Cbt.lock)) and Cbt.lock
        or findMeleeTarget(getMeleeRange() + 20)
    if not tgt then
        Cbt._deadLogAt = nil
        return
    end
    if _G.DR_DEADLOG ~= true then
        Cbt._deadLogAt = nil
        return
    end
    if Cbt._deadLogAt and now - Cbt._deadLogAt < 1.2 then
        return
    end
    Cbt._deadLogAt = now
    local df = DualForm
    local r1 = tostring(tonumber(LocalPlayer:GetAttribute("Skill1_CooldownRemaining")) or -9)
    local r2 = tostring(tonumber(LocalPlayer:GetAttribute("Skill2_CooldownRemaining")) or -9)
    local r3 = tostring(tonumber(LocalPlayer:GetAttribute("Skill3_CooldownRemaining")) or -9)
    local r4 = tostring(tonumber(LocalPlayer:GetAttribute("Skill4_CooldownRemaining")) or -9)
    local s1 = math.floor((now - (lastSkillCast[Cbt.dualCastKey(1)] or 0)) * 10) / 10
    local s2 = math.floor((now - (lastSkillCast[Cbt.dualCastKey(2)] or 0)) * 10) / 10
    local s3 = math.floor((now - (lastSkillCast[Cbt.dualCastKey(3)] or 0)) * 10) / 10
    local s4 = math.floor((now - (lastSkillCast[4] or 0)) * 10) / 10
    warn(string.format("[DEAD] %.1fs noFire | busyL=%.2f holdL=%.2f pend=%s freeze=%s | last=%s | rem=%s,%s,%s,%s since=%s,%s,%s,%s | form=%s spear=%s lock=%s",
        gap, skillBusyUntil - now, skillHoldUntil - now,
        tostring(skillPending and skillPending.slot), tostring(skillFreezeMove),
        tostring(Cbt.lastFireSlot),
        r1, r2, r3, r4, tostring(s1), tostring(s2), tostring(s3), tostring(s4),
        tostring(df and df.on), tostring(df and df.spear),
        tostring(Cbt.lock and Cbt.lock.model and Cbt.lock.model.Name)))
end

TheKing.BindToggle(BattleTab, {
    Title = "杀戮技能光环 (自动放技能)",
    Flag = "dr_skill_aura",
    Interval = 0.05,
    OnEnable = function()
        local cp = CLASS_PROFILES[classIdx]
        if not (cp and cachedClassSkills(cp.Folder)) then
            TheKing.Notify({ Title = "技能光环", Content = "技能数据读取失败, 请确认职业档案存在", Icon = "alert-triangle" })
            return false
        end
        skillAuraOn = true
        skillAuraLastSlot = nil
        skillPending = nil
        skillBusyUntil = 0
        skillDumpSlot = nil
        skillRestUntil = 0
        skillFreezeMove = false
        Cbt.swapWatch = nil
        Cbt.swapFailAt = nil
        if not meleeEnabled then
            Cbt.lock = nil
        end
        Cbt.syncBossParry()
        Cbt.syncKite()
        Cbt.syncAoeDodge()
        return true
    end,
    OnDisable = function()
        skillAuraOn = false
        skillAuraLastSlot = nil
        skillPending = nil
        skillBusyUntil = 0
        skillDumpSlot = nil
        skillRestUntil = 0
        skillFreezeMove = false
        Cbt.swapWatch = nil
        Cbt.swapFailAt = nil
        if not meleeEnabled then
            Cbt.lock = nil
        end
        Cbt.syncBossParry()
        Cbt.syncKite()
        Cbt.syncAoeDodge()
        local humOff = getHum()
        if humOff then
            pcall(function()
                humOff.AutoRotate = true
                if (humOff.WalkSpeed or 0) < 1 then
                    humOff.WalkSpeed = 16
                end
            end)
        end
    end,
    OnTick = function()
        Cbt.syncClass()
        Cbt.tickAoeDodge()
        local hrp = getHRP()
        local hum = getHum()
        if not (hrp and hum) or hum.Health <= 0 then
            skillPending = nil
            return
        end
        local now = os.clock()
        Cbt.tickSwapWatch(now) -- v1.16.3: 4 切形态翻转确认 → 提前解静默窗, 切完无缝连发不罚站
        if now < skillBusyUntil then
            Cbt.auditDead(now) -- v1.16.5-dbg: busy 锁着也无出手 → 抓长锁死寂
            if skillFreezeMove then
                local tgt = (Cbt.lock and Cbt.alive(Cbt.lock)) and Cbt.lock or findMeleeTarget(getMeleeRange() + 8)
                if tgt then
                    faceTowards(hrp, tgt.hrp.Position)
                end
            end
            return
        end
        skillFreezeMove = false
        skillPending = nil
        local res = findReadySkill(now)
        if not res then
            Cbt.auditDead(now) -- v1.16.5-dbg: 无技能可放也无出手 → 抓"技能 CD 中平A 也停"
            return
        end
        skillCursor = res.slot
        faceTowards(hrp, res.target.hrp.Position)
        fireQueuedSkill({ slot = res.slot, target = res.target }, now)
    end,
})

TheKing.BindToggle(BattleTab, {
    Title = "永不使用终极技能",
    Flag = "dr_never_ult",
    Interval = 2,
    OnEnable = function()
        neverUlt = true
        return true
    end,
    OnDisable = function()
        neverUlt = false
    end,
    OnTick = function()
    end,
})

Cbt.classDrop = BattleTab:Dropdown({
    Title = "职业 (自动跟角色)",
    Values = classLabels,
    Value = classLabels[classIdx],
    Flag = "dr_class_profile",
    Callback = function(sel)
        for i, cp in ipairs(CLASS_PROFILES) do
            if cp.Label == sel then
                classIdx = i
                prefSet("classLabel", sel)
                break
            end
        end
        Cbt.syncClass()
    end,
})

-- ============================================================
-- 自动选择 BUFF (祭坛 Blessing_Altar 三选一: 玩家多选偏好, 命中自动选, 多命中按强度择优)
-- ============================================================
local BUFF_LIST = {
    { id = "dmg_up", label = "伤害提升" },
    { id = "move_up", label = "移速提升" },
    { id = "hp_up", label = "生命提升" },
    { id = "kill_xp", label = "击杀经验" },
    { id = "clear_xp", label = "通关经验" },
    { id = "coins", label = "金币" },
    { id = "skill_dmg", label = "技能伤害" },
    { id = "crit_rate", label = "暴击率" },
    { id = "skill_crit_rate", label = "技能暴击率" },
    { id = "skill_crit_dmg", label = "技能爆伤" },
    { id = "dmg_reduction", label = "减伤" },
    { id = "parry_window", label = "格挡窗口" },
    { id = "dodge_cd", label = "闪避冷却" },
    { id = "skill_cd", label = "技能冷却" },
}
-- 多个命中时的强度优先级 (输出 > 防御 > 经验/金币)
local BUFF_PICK_SCORE = {
    dmg_up = 100, skill_dmg = 96, skill_crit_dmg = 92, crit_rate = 88,
    skill_crit_rate = 84, skill_cd = 80, dmg_reduction = 74, hp_up = 68,
    move_up = 60, dodge_cd = 55, parry_window = 50, kill_xp = 40,
    clear_xp = 30, coins = 10,
}
function Cbt.findBlessPrompt()
    local hrp = getHRP()
    if not hrp then
        return nil
    end
    local used = Cbt.blessUsed
    if type(used) ~= "table" then
        used = {}
        Cbt.blessUsed = used
    end
    local best, bestD = nil, 1e9
    local pos = hrp.Position
    for _, c in ipairs(workspace:GetChildren()) do
        if type(c.Name) == "string" and string.sub(c.Name, 1, 10) == "Generated_" then
            for _, d in ipairs(c:GetDescendants()) do
                if d:IsA("ProximityPrompt") and d.Enabled and d.Parent and not used[d] then
                    if d.ActionText == "Receive Blessing" then
                        local part = d:FindFirstAncestorWhichIsA("BasePart")
                        local ppos = part and part.Position
                        if ppos then
                            local dist = (pos - ppos).Magnitude
                            local maxd = (tonumber(d.MaxActivationDistance) or 10) + 1.5
                            if dist <= maxd and dist < bestD then
                                bestD = dist
                                best = d
                            end
                        end
                    end
                end
            end
        end
    end
    return best
end
function Cbt.tryOpenAltar()
    if not hubAlive then
        return
    end
    local prompt = Cbt.findBlessPrompt()
    if not prompt then
        return
    end
    local now = os.clock()
    if prompt == Cbt.blessLast and Cbt.blessFireAt > 0 and (now - Cbt.blessFireAt) < 1.1 then
        return
    end
    Cbt.blessLast = prompt
    Cbt.blessFireAt = now
    if type(fireproximityprompt) == "function" then
        pcall(fireproximityprompt, prompt)
        return
    end
    pcall(function()
        prompt:InputHoldBegin()
        task.delay(math.max(0.08, prompt.HoldDuration or 0.25), function()
            pcall(function()
                prompt:InputHoldEnd()
            end)
        end)
    end)
end
local autoBuffOn = false
local autoBuffFiredAt = nil
local buffPrefsById = {}
local _boostCtrlCache = nil
local function boostCtrl()
    if _boostCtrlCache then
        return _boostCtrlCache
    end
    local client = LocalPlayer:FindFirstChild("PlayerScripts") and LocalPlayer.PlayerScripts:FindFirstChild("Client")
    local mod = client and client:FindFirstChild("Controllers") and client.Controllers:FindFirstChild("BoostSelectionController")
    if mod then
        local ok, c = pcall(require, mod)
        if ok and type(c) == "table" then
            _boostCtrlCache = c
        end
    end
    return _boostCtrlCache
end

TheKing.BindToggle(BattleTab, {
    Title = "自动选择 BUFF (祭坛)",
    Flag = "dr_auto_buff",
    Interval = 0.25,
    OnEnable = function()
        autoBuffOn = true
        return true
    end,
    OnDisable = function()
        autoBuffOn = false
        Cbt.blessLast = nil
    end,
    OnTick = function()
        if not hubAlive then
            return
        end
        local ctrl = boostCtrl()
        local uiOn = ctrl and ctrl._active == true
        if Cbt.blessWasUi and not uiOn then
            autoBuffFiredAt = nil
            Cbt.blessPickSig = nil
            if Cbt.blessLast then
                local used = Cbt.blessUsed
                if type(used) ~= "table" then
                    used = {}
                    Cbt.blessUsed = used
                end
                used[Cbt.blessLast] = true
                Cbt.blessLast = nil
            end
        end
        if uiOn then
            if Cbt.blessUiAt <= 0 then
                Cbt.blessUiAt = os.clock()
            end
            if os.clock() - Cbt.blessUiAt > 18 then
                uiOn = false
                Cbt.blessUiAt = 0
            end
        else
            Cbt.blessUiAt = 0
        end
        Cbt.blessWasUi = uiOn
        if not uiOn then
            Cbt.tryOpenAltar()
            return
        end
        if not (ctrl._ready and not ctrl._selecting) then
            return
        end
        local cands = ctrl._candidates
        if not cands or #cands == 0 then
            return
        end
        local bestIdx, bestScore = nil, -1
        for i, cand in ipairs(cands) do
            if buffPrefsById[cand.Id] then
                local s = BUFF_PICK_SCORE[cand.Id] or 1
                if s > bestScore then
                    bestScore = s
                    bestIdx = i
                end
            end
        end
        if not bestIdx then
            -- 三个候选都不是偏好: 随机选一个, 别让选择窗卡住
            bestIdx = math.random(1, #cands)
        end
        local sig = tostring(#cands)
        for i, cand in ipairs(cands) do
            sig = sig .. "|" .. tostring(cand.Id)
        end
        if Cbt.blessPickSig == sig then
            return
        end
        Cbt.blessPickSig = sig
        autoBuffFiredAt = os.clock()
        task.delay(0.9, function()
            if not hubAlive then
                return
            end
            pcall(function()
                if ctrl._active and ctrl._ready and not ctrl._selecting then
                    ctrl:_OnCardClicked(bestIdx)
                end
            end)
        end)
    end,
})
-- 偏好 BUFF: 自绘紧凑网格多选 (绕开 Rayfield 多选下拉弹层 — 该组件在本游戏+Potassium 下渲染必崩)
-- 纯 Instance 操作 (与范围圈/宝箱文字同路线), 零崩溃面; 选中态存 buffPrefsById
do
    local page = BattleTab:RawPage()
    if page then
        local function nextOrder()
            local mx = 0
            for _, c in ipairs(page:GetChildren()) do
                if c:IsA("GuiObject") then
                    mx = math.max(mx, c.LayoutOrder)
                end
            end
            return mx + 1
        end
        local cap = Instance.new("TextLabel")
        cap.BackgroundTransparency = 1
        cap.BorderSizePixel = 0
        cap.Font = Enum.Font.GothamBold
        cap.Text = "偏好 BUFF (点选, 可多选; 命中自动选最高分)"
        cap.TextColor3 = Color3.fromRGB(172, 178, 190)
        cap.TextSize = 13
        cap.TextXAlignment = Enum.TextXAlignment.Left
        cap.Size = UDim2.new(1, -24, 0, 20)
        cap.LayoutOrder = nextOrder()
        cap.Parent = page

        local holder = Instance.new("Frame")
        holder.BackgroundTransparency = 1
        holder.BorderSizePixel = 0
        holder.Size = UDim2.new(1, -24, 0, 0)
        holder.AutomaticSize = Enum.AutomaticSize.Y
        holder.LayoutOrder = nextOrder()
        holder.Parent = page

        local grid = Instance.new("UIGridLayout")
        grid.CellPadding = UDim2.fromOffset(6, 6)
        grid.CellSize = UDim2.fromOffset(138, 32)
        grid.SortOrder = Enum.SortOrder.LayoutOrder
        grid.Parent = holder

        local COLOR_BG = Color3.fromRGB(33, 38, 48)
        local COLOR_OFF = Color3.fromRGB(206, 212, 222)
        local COLOR_ON_BG = Color3.fromRGB(76, 124, 255)
        local COLOR_ON = Color3.new(1, 1, 1)

        local buffBtns = {}
        -- 恢复上次偏好选择 (自建持久化 dr-prefs.txt)
        if type(PREF.buffs) == "string" and PREF.buffs ~= "" then
            for id in (PREF.buffs .. ","):gmatch("([^,]+),") do
                if id ~= "" then
                    buffPrefsById[id] = true
                end
            end
        end
        local function syncGridWidth()
            local w = holder.AbsoluteSize.X
            if w > 40 then
                local cols = 4
                local cell = math.floor((w - 6 * (cols - 1)) / cols)
                grid.CellSize = UDim2.fromOffset(math.max(cell, 60), 32)
            end
        end
        holder:GetPropertyChangedSignal("AbsoluteSize"):Connect(syncGridWidth)
        task.delay(0.6, syncGridWidth)

        local function paint(btn, on)
            if on then
                btn.BackgroundColor3 = COLOR_ON_BG
                btn.TextColor3 = COLOR_ON
                btn.BorderSizePixel = 0
            else
                btn.BackgroundColor3 = COLOR_BG
                btn.TextColor3 = COLOR_OFF
                btn.BorderSizePixel = 0
            end
        end
        for i, b in ipairs(BUFF_LIST) do
            local btn = Instance.new("TextButton")
            btn.BackgroundColor3 = COLOR_BG
            btn.BorderSizePixel = 0
            btn.Font = Enum.Font.GothamMedium
            btn.Text = b.label
            btn.TextSize = 13
            btn.TextColor3 = COLOR_OFF
            btn.AutoButtonColor = false
            btn.LayoutOrder = i
            btn.Parent = holder
            local hovered = false
            btn.MouseEnter:Connect(function()
                hovered = true
                if not buffPrefsById[b.id] then
                    btn.BackgroundColor3 = COLOR_BG:lerp(Color3.new(1, 1, 1), 0.08)
                end
            end)
            btn.MouseLeave:Connect(function()
                hovered = false
                paint(btn, buffPrefsById[b.id] == true)
            end)
            btn.Activated:Connect(function()
                if buffPrefsById[b.id] then
                    buffPrefsById[b.id] = nil
                else
                    buffPrefsById[b.id] = true
                end
                paint(btn, buffPrefsById[b.id] == true)
                -- 持久化: 序列化 id 列表写入 PREF + 防抖保存
                local ids = {}
                for id in pairs(buffPrefsById) do
                    ids[#ids + 1] = id
                end
                PREF.buffs = table.concat(ids, ",")
                prefSave()
            end)
            paint(btn, buffPrefsById[b.id] == true)
            buffBtns[#buffBtns + 1] = btn
        end
        TheKing.OnCleanup(function()
            for _, btn in ipairs(buffBtns) do
                pcall(function()
                    btn:Destroy()
                end)
            end
            pcall(function()
                cap:Destroy()
            end)
            pcall(function()
                holder:Destroy()
            end)
        end)
    else
        warn("[RCWTK] RawPage nil, 偏好网格不可用")
    end
end

-- ============================================================
-- 自动选择结算宝箱 (Boss/关卡结算宝箱选择: 自动挑稀有度最高的填满槽位并确认)
-- ============================================================
local autoChestOn = false
local _chestCtrlCache = nil
local _rarityIdxCache = nil
local function chestCtrl()
    if _chestCtrlCache then
        return _chestCtrlCache
    end
    local client = LocalPlayer:FindFirstChild("PlayerScripts") and LocalPlayer.PlayerScripts:FindFirstChild("Client")
    local mod = client and client:FindFirstChild("Controllers") and client.Controllers:FindFirstChild("ChestSelectionController")
    if mod then
        local ok, c = pcall(require, mod)
        if ok and type(c) == "table" then
            _chestCtrlCache = c
        end
    end
    return _chestCtrlCache
end
local function rarityIndex()
    if _rarityIdxCache then
        return _rarityIdxCache
    end
    _rarityIdxCache = {}
    local rd = game.ReplicatedStorage:FindFirstChild("GameInfo") and game.ReplicatedStorage.GameInfo:FindFirstChild("RarityData")
    if rd then
        local ok, t = pcall(require, rd)
        if ok and type(t) == "table" and type(t.RarityIndex) == "table" then
            _rarityIdxCache = t.RarityIndex
        end
    end
    return _rarityIdxCache
end

TheKing.BindToggle(BattleTab, {
    Title = "自动选择结算宝箱",
    Flag = "dr_auto_chest",
    Interval = 0.4,
    OnEnable = function()
        autoChestOn = true
        return true
    end,
    OnDisable = function()
        autoChestOn = false
    end,
    OnTick = function()
        local ctrl = chestCtrl()
        if not ctrl then
            return
        end
        -- 结算宝箱界面未激活或入场动画未完
        if not (ctrl._active and ctrl._ready) then
            return
        end
        -- 玩家已手动选过 (或本轮已处理) -> 不干预
        if (ctrl._selectedCount or 0) > 0 then
            return
        end
        local cands = ctrl._candidates
        if not cands or #cands == 0 then
            return
        end
        -- 按稀有度倒序 (Epic > Rare > Uncommon...)
        local idx = rarityIndex()
        local ranked = {}
        for i, cand in ipairs(cands) do
            ranked[#ranked + 1] = { i = i, r = tonumber(idx[cand.Rarity]) or 99 }
        end
        table.sort(ranked, function(a, b)
            return a.r > b.r
        end)
        local maxPick = ctrl._maxPicks or 2
        local picks = {}
        for n = 1, math.min(maxPick, #ranked) do
            picks[#picks + 1] = ranked[n].i
        end
        -- 逐个模拟点选 (间隔 0.35s 播入场动画) 后自动确认
        for n, pi in ipairs(picks) do
            task.delay((n - 1) * 0.35, function()
                pcall(function()
                    ctrl:_OnChestClicked(pi)
                end)
            end)
        end
        task.delay(#picks * 0.35 + 0.4, function()
            pcall(function()
                if ctrl._active and (ctrl._selectedCount or 0) >= maxPick then
                    ctrl:_OnFinish()
                end
            end)
        end)
    end,
})

-- ============================================================
-- 自动补充药水 (炼药锅 Potion_Station: 靠近 Refill Potions 自动交互)
-- ============================================================
function Cbt.findRefillPrompt()
    local hrp = getHRP()
    if not hrp then
        return nil
    end
    local now = os.clock()
    local list = Cbt._refillPrompts
    if type(list) ~= "table" or (now - (Cbt._refillScanAt or 0)) > 1.6 then
        list = {}
        for _, d in ipairs(workspace:GetDescendants()) do
            if d:IsA("ProximityPrompt") then
                if d.ActionText == "Refill Potions" or d.ObjectText == "Potion Station" then
                    list[#list + 1] = d
                end
            end
        end
        Cbt._refillPrompts = list
        Cbt._refillScanAt = now
    end
    local best, bestD = nil, 1e9
    local pos = hrp.Position
    for _, d in ipairs(list) do
        if d.Parent and d:IsA("ProximityPrompt") and d.Enabled then
            local part = d:FindFirstAncestorWhichIsA("BasePart")
            local ppos = part and part.Position
            if ppos then
                local dist = (pos - ppos).Magnitude
                local maxd = (tonumber(d.MaxActivationDistance) or 10) + 1.5
                if dist <= maxd and dist < bestD then
                    bestD = dist
                    best = d
                end
            end
        end
    end
    return best
end
function Cbt.tryRefillPotions()
    if not hubAlive then
        return
    end
    local prompt = Cbt.findRefillPrompt()
    if not prompt then
        return
    end
    local now = os.clock()
    if prompt == Cbt.refillLast and Cbt.refillFireAt > 0 and (now - Cbt.refillFireAt) < 1.1 then
        return
    end
    Cbt.refillLast = prompt
    Cbt.refillFireAt = now
    if type(fireproximityprompt) == "function" then
        pcall(fireproximityprompt, prompt)
        return
    end
    pcall(function()
        prompt:InputHoldBegin()
        task.delay(math.max(0.08, prompt.HoldDuration or 0.25), function()
            pcall(function()
                prompt:InputHoldEnd()
            end)
        end)
    end)
end

TheKing.BindToggle(BattleTab, {
    Title = "自动补充药水",
    Flag = "dr_auto_refill",
    Interval = 0.3,
    OnDisable = function()
        Cbt.refillLast = nil
        Cbt._refillPrompts = nil
    end,
    OnTick = function()
        if not hubAlive then
            return
        end
        Cbt.tryRefillPotions()
    end,
})

-- ============================================================
-- Tab: 移动
-- ============================================================
local MoveTab = TheKing.NewTab({ Title = "移动", Icon = "person-standing" })

TheKing.BindToggle(MoveTab, {
    Title = "自动奔跑",
    Flag = "dr_autosprint",
    Interval = 0.5,
    OnTick = function()
        local hum = getHum()
        if not hum or hum.Health <= 0 then
            return
        end
        local moving = hum.MoveDirection.Magnitude > 0.1
        local sprinting = LocalPlayer:GetAttribute("Sprint_Active") == true
        if moving and not sprinting then
            TheKing.Fire(SprintRE, "start")
        elseif not moving and sprinting then
            TheKing.Fire(SprintRE, "stop")
        end
    end,
})

local targetSpeed = tonumber(PREF.speedVal) or 35
local speedEnabled = false
function Cbt.wsTick()
    if not hubAlive then
        return
    end
    local hum = getHum()
    if not hum then
        return
    end
    if Cbt._wsApplying then
        return
    end
    local now = os.clock()
    local want = nil
    if now < skillBusyUntil and skillFreezeMove then
        Cbt._wsWasFreeze = true
        want = 0
    else
        if now >= skillBusyUntil then
            skillFreezeMove = false
        end
        if speedEnabled then
            Cbt._wsWasFreeze = false
            want = tonumber(targetSpeed) or 35
        elseif Cbt._wsWasFreeze then
            Cbt._wsWasFreeze = false
            want = 16
        end
    end
    if want == nil then
        return
    end
    if math.abs(hum.WalkSpeed - want) > 0.05 then
        Cbt._wsApplying = true
        hum.WalkSpeed = want
        Cbt._wsApplying = false
    end
end
function Cbt.hookWsHum()
    local hum = getHum()
    if not hum or Cbt._wsHum == hum then
        return
    end
    Cbt._wsHum = hum
    if Cbt._wsConn then
        pcall(function()
            Cbt._wsConn:Disconnect()
        end)
    end
    Cbt._wsConn = hum:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
        Cbt.wsTick()
    end)
    TheKing.AddConnection(Cbt._wsConn)
end
TheKing.BindToggle(MoveTab, {
    Title = "移速修改",
    Flag = "dr_speed",
    Interval = 999,
    OnEnable = function()
        speedEnabled = true
        Cbt.hookWsHum()
        Cbt.wsTick()
        return true
    end,
    OnDisable = function()
        speedEnabled = false
    end,
})
MoveTab:Slider({
    Title = "移速目标值",
    Value = { Min = 10, Max = 120, Default = tonumber(PREF.speedVal) or 35 },
    Step = 1,
    Callback = function(v)
        local n = tonumber(v)
        if not n then
            return
        end
        targetSpeed = math.clamp(n, 10, 120)
        PREF.speedVal = targetSpeed
        prefSave()
        if speedEnabled then
            Cbt.wsTick()
        end
    end,
})
TheKing.AddConnection(RunService.Heartbeat:Connect(function()
    if not hubAlive then
        return
    end
    Cbt.hookWsHum()
    Cbt.wsTick()
end))


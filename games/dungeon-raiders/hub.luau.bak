    Color = Color3.fromRGB(255, 100, 100),
    Callback = unloadAction,
})

-- ============================================================
-- 反挂机 (v1.13.0, 移植自重型钓鱼防踢心跳): 解决爬塔闲置 20 分钟被踢
-- 主路: 每 60s 重掐 LocalPlayer.Idled 引擎连接 (getconnections:Disable)
-- 脉冲: VirtualUser + VirtualInputManager 微动/F15 + mousemoverel + keytap (失焦也发, 不跳跃)
-- 退路: 自挂 Idled → 立刻多重脉冲 (主路已掐光时很少触发, 无害)
-- ============================================================
do
    local disabledIdle = {}
    local idleConn = nil
    local antiIdleOn = false
    local PULSE_INTERVAL = 60 -- 远低于引擎 ~20min 闲置踢; 定期重掐防连接被重建

    local function pulseInput()
        pcall(function()
            local vu = game:GetService("VirtualUser")
            vu:CaptureController()
            vu:ClickButton2(Vector2.new())
        end)
        pcall(function()
            local vim = game:GetService("VirtualInputManager")
            local cam = workspace.CurrentCamera
            local vp = cam and cam.ViewportSize or Vector2.new(800, 600)
            local x = vp.X * 0.5
            local y = vp.Y * 0.5
            vim:SendMouseMoveEvent(x + 1, y, game)
            vim:SendMouseMoveEvent(x, y, game)
            vim:SendKeyEvent(true, Enum.KeyCode.F15, false, game)
            vim:SendKeyEvent(false, Enum.KeyCode.F15, false, game)
        end)
        if type(mousemoverel) == "function" then
            pcall(mousemoverel, 1, 0)
            pcall(mousemoverel, -1, 0)
        end
        if type(keytap) == "function" then
            pcall(keytap, 0x7E) -- VK_F15, 游戏无绑定
        end
    end

    local function stopAntiIdle()
        antiIdleOn = false
        TheKing.StopLoop("antiIdle")
        if idleConn then
            pcall(function()
                idleConn:Disconnect()
            end)
            idleConn = nil
        end
        for _, con in ipairs(disabledIdle) do
            pcall(function()
                con:Enable()
            end)
        end
        table.clear(disabledIdle)
    end

    local function disableEngineIdle()
        local gc = nil
        if type(getconnections) == "function" then
            gc = getconnections
        elseif type(get_signal_cons) == "function" then
            gc = get_signal_cons
        end
        if type(gc) ~= "function" then
            return 0
        end
        local ok, list = pcall(gc, LocalPlayer.Idled)
        if not ok or type(list) ~= "table" then
            return 0
        end
        local n = 0
        for _, con in pairs(list) do
            -- 直接 pcall:Disable — Potassium 返回 userdata ConnectionObject,
            -- 方法在元表上, 不要先用 type(con)=="table" 挡掉
            local disabled = pcall(function()
                con:Disable()
            end)
            if not disabled then
                disabled = pcall(function()
                    con.Disable(con)
                end)
            end
            if not disabled then
                disabled = pcall(function()
                    con:Disconnect()
                end)
            end
            if disabled then
                table.insert(disabledIdle, con)
                n = n + 1
            end
        end
        return n
    end

    local function attachVirtualIdle()
        if idleConn then
            pcall(function()
                idleConn:Disconnect()
            end)
            idleConn = nil
        end
        local ok, conn = pcall(function()
            return LocalPlayer.Idled:Connect(function()
                if not antiIdleOn then
                    return
                end
                -- 仍触发 Idled = 连接可能被重建, 立刻掐 + 脉冲
                disableEngineIdle()
                pulseInput()
            end)
        end)
        if ok and conn then
            idleConn = conn
            return true
        end
        return false
    end

    local function startAntiIdle()
        stopAntiIdle()
        antiIdleOn = true
        disableEngineIdle()
        attachVirtualIdle()
        -- 再掐一次: attach 后 list 含自建连接也会被禁 —
        -- 主动脉冲循环才是权威续命; Idled 退路仅在 getconnections 不可用时兜底
        disableEngineIdle()
        TheKing.StartLoop("antiIdle", PULSE_INTERVAL, function()
            if not antiIdleOn then
                return
            end
            -- getconnections/Disable 与假输入都可能百毫秒级, 整段 defer 避免慢循环告警
            task.defer(function()
                if not antiIdleOn then
                    return
                end
                disableEngineIdle()
                pulseInput()
            end)
        end)
        task.defer(function()
            if antiIdleOn then
                disableEngineIdle()
                pulseInput()
            end
        end)
        return true
    end

    TheKing.OnCleanup(stopAntiIdle)

    SettingsTab:Toggle({
        Title = "反挂机 (防闲置踢)",
        Desc = "每分钟重掐闲置计时+多通道假输入, 失焦也生效, 不跳跃",
        Value = (tonumber(PREF.antiIdle) or 1) ~= 0,
        Callback = function(state)
            PREF.antiIdle = state and 1 or 0
            prefSave()
            if state then
                startAntiIdle()
                TheKing.Notify({ Content = "反挂机已开启", Icon = "heart-pulse" })
            else
                stopAntiIdle()
                TheKing.Notify({ Content = "反挂机已关闭", Icon = "circle-off" })
            end
        end,
    })

    -- WindUI Toggle Value=true 创建时不触发 Callback (引擎已知坑) → 按持久化状态强制启动
    if (tonumber(PREF.antiIdle) or 1) ~= 0 then
        startAntiIdle()
    end
end



-- 主绘制循环: 对象池计数制, 未使用的对象由 overlayFrameEnd 自动隐藏; 全程 pcall 兜底防崩
-- 注: 曾加"鼠标按住暂停"防护 (v1.0.32), 但误伤右键拖视角 (按住右键=游戏常态视角操作)
--     崩溃定案后证实绘制与崩溃无关, 防护已移除 — 无条件绘制
function Cbt.drawFrame()
    if not hubAlive then
        return
    end
    local ok, err = pcall(function()
        local my = getHRP()
        local both = meleeEnabled and skillAuraOn
        if both and my then
            -- 双光环融合: 只画一个蓝圈, 半径取平A/技能最大
            local sr = 0
            local cp = CLASS_PROFILES[classIdx]
            local skills = cp and cachedClassSkills(cp.Folder)
            if skills then
                for i = 1, 4 do
                    if skills[i] then
                        sr = math.max(sr, skillRange(skills[i]))
                    end
                end
            end
            Ov.ring(my, math.max(getMeleeRange(), sr), Color3.fromRGB(80, 140, 255), 0)
        elseif meleeEnabled and my then
            Ov.ring(my, getMeleeRange(), Color3.fromRGB(255, 60, 60), 0)
        elseif skillAuraOn and my then
            local cp = CLASS_PROFILES[classIdx]
            local skills = cp and cachedClassSkills(cp.Folder)
            local sr, slot = nil, skillAuraLastSlot
            if skills then
                if slot and skills[slot] then
                    sr = skillRange(skills[slot])
                else
                    sr = 0
                    for i = 1, 4 do
                        if skills[i] then
                            sr = math.max(sr, skillRange(skills[i]))
                        end
                    end
                    if sr <= 0 then
                        sr = nil
                    end
                end
            end
            if sr then
                local holding = slot and os.clock() < skillHoldUntil
                Ov.ring(my, sr, Color3.fromRGB(255, 220, 60), holding and 0 or 0.28)
            end
        end
        if chestEspOn then
            paintChestEsp()
        end
        if warnOn then
            paintWarnRadar()
        end
        Ov.frameEnd()
    end)
    if not ok and err then
        Ov.reset()
        if Cbt.drawErr ~= err then
            Cbt.drawErr = err
            warn("[RCWTK] drawFrame error: " .. tostring(err))
        end
    end
end
function Cbt.drawCombat()
    if not hubAlive then
        return
    end
    local ok, err = pcall(function()
        if (meleeEnabled or skillAuraOn) and Cbt.lock and Cbt.alive(Cbt.lock) then
            local pulse = 0.28 + 0.22 * (0.5 + 0.5 * math.sin(os.clock() * 7))
            local both = meleeEnabled and skillAuraOn
            local col = both and Color3.fromRGB(80, 140, 255) or (skillAuraOn and not meleeEnabled and Color3.fromRGB(255, 220, 70) or Color3.fromRGB(255, 55, 55))
            Cbt.disc("rLock", Cbt.lock.hrp, 2.7, col, pulse, -2.5)
            Cbt.disc("rLock2", Cbt.lock.hrp, 1.25, col, math.min(0.72, pulse + 0.18), -2.5)
        else
            Cbt.disc("rLock", nil)
            Cbt.disc("rLock2", nil)
        end
    end)
    if not ok and err and Cbt.drawErr ~= err then
        Cbt.drawErr = err
        warn("[RCWTK] drawCombat error: " .. tostring(err))
    end
end

-- ============================================================
-- Spin Tap (v1.21.2): 自动 Lucky/Normal Spin
-- 放在主块最末尾(绘制段后), 不嵌 IIFE wrapper, 顶 200 改用 Cbt 表法
-- Aspect="默认"=任何 Aspect 都接受; Spin.running 默认 false, 不持久化
-- ============================================================

-- 抽卡 UI 元素 (主 IIFE 局部) - 提为 Cbt 字段避免主块 local 顶 200
Cbt._spin = {
    filter = { classes = {}, aspect = "默认" },
    isLucky = true,
    remain = 1,
    running = false,
}

local SPIN_CLASS_LIST = {}
do
    local okCD, cd = pcall(require, game:GetService("ReplicatedStorage").Classes.Class_Data)
    if okCD and cd and cd.GetAllClassNames then
        local names = cd.GetAllClassNames()
        table.sort(names)
        for _, n in ipairs(names) do SPIN_CLASS_LIST[#SPIN_CLASS_LIST + 1] = n end
    end
end
local SPIN_ASPECT_LIST = {
    "Blaze", "Fulmin", "Glaciel", "Verdant",
    "Sanguine", "Umbral", "Aegis", "Tempest",
    "Phantom", "Ruin", "Alacrity",
}

function Cbt.spinGetRF()
    local ss = game:GetService("ReplicatedStorage")
        .Packages._Index["sleitnick_knit@1.7.0"].knit.Services.SummoningService
    return ss and ss.RF and ss.RF:FindFirstChild("Spin")
end

function Cbt.spinReadResult()
    local dlg = game:GetService("Players").LocalPlayer.PlayerGui:FindFirstChild("dialog", true)
    if not dlg then return nil end
    for _, c in dlg:GetDescendants() do
        if c:IsA("TextLabel") then
            local t = c.Text
            if t and t ~= "" then
                for _, cn in ipairs(SPIN_CLASS_LIST) do
                    if t:find(cn, 1, true) then return cn end
                end
            end
        end
    end
    return nil
end

function Cbt.spinClickReject()
    local dlg = game:GetService("Players").LocalPlayer.PlayerGui:FindFirstChild("dialog", true)
    if not dlg then return end
    for _, c in dlg:GetDescendants() do
        if c:IsA("TextButton") then
            local t = (c.Text or ""):lower()
            if t:find("refuse") or t:find("reject") or t:find("拒绝") or t:find("no") or t:find("cancel") then
                pcall(function() firesignal(c.Activated) end)
                return
            end
        end
    end
end

function Cbt.spinDismiss()
    -- 关闭 Purchase Pending + 警告
    local pg = game:GetService("Players").LocalPlayer.PlayerGui
    local pp = pg:FindFirstChild("Purchase Pending", true)
    if pp and pp.Enabled then
        for _, c in pp:GetDescendants() do
            if c:IsA("TextButton") or c:IsA("ImageButton") then
                pcall(function() firesignal(c.Activated) end)
                return
            end
        end
    end
end

local function spinPass(className)
    local f = Cbt._spin.filter
    if f.classes and #f.classes > 0 then
        local hit = false
        for _, c in ipairs(f.classes) do if c == className then hit = true break end end
        if not hit then return false end
    end
    -- Aspect 默认=接受任何
    return true
end

local spinTab = TheKing.NewTab({ Title = "Spin", Icon = "zap" })

spinTab:Dropdown({
    Title = "Spin 类型",
    Values = { "Lucky Spin", "Normal Spin" },
    Value = "Lucky Spin",
    Callback = function(v) Cbt._spin.isLucky = (v == "Lucky Spin") end,
})

spinTab:MultiDropdown({
    Title = "职业过滤 (空=全部)",
    Values = SPIN_CLASS_LIST,
    Value = {},
    AllowNone = true,
    Callback = function(v) Cbt._spin.filter.classes = v end,
})

spinTab:Dropdown({
    Title = "特性过滤",
    Values = { "默认", unpack(SPIN_ASPECT_LIST) },
    Value = "默认",
    Callback = function(v) Cbt._spin.filter.aspect = v end,
})

spinTab:Input({
    Title = "次数 (0=手动停止)",
    Type = "Default",
    Placeholder = "0 = 手动停止",
    Value = "1",
    Callback = function(v) Cbt._spin.remain = tonumber(v) or 0 end,
})

spinTab:Button({
    Title = "开始自动 Spin",
    Icon = "play",
    Callback = function()
        if Cbt._spin.running then
            TheKing.Notify({ Content = "Spin 已在运行", Icon = "alert-circle" })
            return
        end
        Cbt._spin.running = true
        TheKing.StartLoop("spin", 200, function()
            if not Cbt._spin.running then return "stop" end
            local r = Cbt._spin.remain
            if r <= 0 then
                Cbt._spin.running = false
                TheKing.Notify({ Content = "Spin 次数用完", Icon = "check-circle" })
                return "stop"
            end
            Cbt.spinDismiss()
            local got = Cbt.spinReadResult()
            if got then
                if spinPass(got) then
                    Cbt._spin.running = false
                    TheKing.Notify({
                        Content = ("抽到 %s, 已停止"):format(got),
                        Icon = "zap",
                    })
                    return "stop"
                else
                    Cbt.spinClickReject()
                    Cbt._spin.remain = Cbt._spin.remain - 1
                end
            else
                local rf = Cbt.spinGetRF()
                if rf then pcall(function() rf:InvokeServer(Cbt._spin.isLucky) end) end
            end
        end)
        TheKing.Notify({ Content = "Spin 已启动", Icon = "zap" })
    end,
})

spinTab:Button({
    Title = "停止 Spin",
    Icon = "square",
    Color = Color3.fromRGB(255, 80, 80),
    Callback = function()
        Cbt._spin.running = false
        TheKing.StopLoop("spin")
        TheKing.Notify({ Content = "Spin 已停止", Icon = "check-circle" })
    end,
})

TheKing.StartLoop("dr_draw_loop", 0.1, Cbt.drawFrame)
TheKing.AddConnection(RunService.Heartbeat:Connect(Cbt.drawCombat))
TheKing.OnCleanup(function()
    hubAlive = false
    speedEnabled = false
    pcall(function()
        TheKing.UnbindStepped("dr_melee_lock")
        TheKing.UnbindStepped("dr_skill_steer")
    end)
    pcall(function()
        Nav.stop()
    end)
    pcall(function()
        local c = LocalPlayer.Character
        local h = c and c:FindFirstChildOfClass("Humanoid")
        if h then
            h.AutoRotate = true
            if (h.WalkSpeed or 0) < 1 then
                h.WalkSpeed = 16
            end
        end
    end)
    if Cbt._wsConn then
        pcall(function()
            Cbt._wsConn:Disconnect()
        end)
        Cbt._wsConn = nil
    end
    Ov.reset()
    Cbt.disc("rLock", nil)
    Cbt.disc("rLock2", nil)
    dpsDestroy()
    Nav.hudDestroy()
end)

-- ============================================================
-- 加载完成
-- ============================================================
Nav.towerWatch()

if TheKing.LoadConfig then
    TheKing.LoadConfig()
end
if TheKing.PinNativeToggleKey then
    TheKing.PinNativeToggleKey()
end

-- 从未 Show 过的窗不要调 Hide (会缩成顶栏药丸); 库里 SetWindowHidden 会保持建窗初态
function Cbt.applyStartHidden()
    if START_UI_HIDDEN or (tonumber(PREF.uiHidden) or 0) ~= 0 then
        if TheKing.SetWindowHidden then
            pcall(TheKing.SetWindowHidden, true)
        end
    end
end
task.delay(0.15, Cbt.applyStartHidden)

-- 自建持久化: 恢复上次开启的开关 (等价逐个人工点击, 触发各自 OnEnable 启动 loop)
-- 延后到 UI 全部建完 + LoadConfig 之后执行, 避免与 Rayfield 配置恢复竞争
task.delay(0.8, function()
    if not hubAlive or not TheKing.RestoreToggle then
        return
    end
    if PREF.t_dr_aoe_dodge == nil then
        PREF.t_dr_aoe_dodge = 1
    end
    for k, v in pairs(PREF) do
        local flag = k:match("^t_(.+)$")
        if flag and v ~= 0 then
            pcall(TheKing.RestoreToggle, flag, true)
        end
    end
end)

    print("[RCWTK] DR_HUB_v1202 loaded")
end)()

local state = {
    authorized = false,   -- 唯一授权位
    checked = false,      -- 是否已尝试拉取
    reason = "pending",   -- 授权结果原因: ok / expired / unauthorized / network
    untilStr = nil,       -- 当前用户到期时间 (nil=永久), 授权 Tab 展示用
    manifest = nil,
    injected = {},
}


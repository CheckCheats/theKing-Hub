    local function playTabEnter(rfTab)
        if not rfBrandMotionAlive or type(rfTab) ~= "table" then
            return
        end
        local page = rfTab.tabPage
        if not page then
            return
        end
        local sc = page:FindFirstChild("TheKingTabScale")

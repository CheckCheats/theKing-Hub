local OWN_WIND_GUI_KEYS = { "ScreenGui", "NotificationGui", "DropdownGui", "TooltipGui" }

local function eachOwnWindGui(fn)
    if WindUI then
        for _, key in ipairs(OWN_WIND_GUI_KEYS) do
            local gui = WindUI[key]
            if gui then
                fn(gui)
            end
        end
    end
